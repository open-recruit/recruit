@inject IStringLocalizer<SharedResources> Localizer

@* Decorative wherever its state is also spelled out as text next to it - aria-label on a plain span
   is ignored by many screen readers, so the icon can't be the only place the state is said. *@
@if (Decorative)
{
    <span class="@CriterionStateDisplay.ColorClass(State)" aria-hidden="true">
        <LucideIcon Name="@CriterionStateDisplay.IconName(State)" Size="@Size" />
    </span>
}
else
{
    <span class="@CriterionStateDisplay.ColorClass(State)" role="img" title="@TooltipText" aria-label="@TooltipText">
        <LucideIcon Name="@CriterionStateDisplay.IconName(State)" Size="@Size" />
    </span>
}

@code {
    [Parameter, EditorRequired]
    public CriterionState State { get; set; }

    /// <summary>Optional free-text explanation (CriterionStatusDto.Note), appended to the tooltip when present.</summary>
    [Parameter]
    public string? Note { get; set; }

    /// <summary>True when the state is also shown as visible text, so the icon is hidden from assistive technology.</summary>
    [Parameter]
    public bool Decorative { get; set; }

    [Parameter]
    public int Size { get; set; } = 16;

    private string TooltipText
    {
        get
        {
            var label = Localizer[CriterionStateDisplay.LabelKey(State)].Value;
            return string.IsNullOrEmpty(Note) ? label : $"{label}: {Note}";
        }
    }
}
