@inject ResearchSubjectService ResearchSubjectService
@inject ErrorReporter Errors
@inject IStringLocalizer<SharedResources> Localizer

<div>
    @if (_loading)
    {
        <div class="bb:space-y-3">
            <BbSkeleton Class="bb:h-12 bb:w-full" />
            <BbSkeleton Class="bb:h-12 bb:w-full" />
            <BbSkeleton Class="bb:h-12 bb:w-full" />
        </div>
    }
    else if (_entries.Count == 0)
    {
        <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientHistory.Empty"]</p>
    }
    else
    {
        <div class="bb:pe-2">
            @* Alternate puts the time in the date column opposite each entry's content. *@
            <BbTimeline Align="TimelineAlign.Alternate" Size="TimelineSize.Small">
                @for (var i = 0; i < _entries.Count; i++)
                {
                    var entry = _entries[i];
                    var color = entry.Kind == PatientHistoryEntryKind.Note ? TimelineColor.Secondary : TimelineColor.Primary;
                    @* Alternate keeps even items' content on the right, so their date column is on
                       the left. TimeContent gets no alignment from the library, so push each date
                       toward the line itself, or the left-hand ones sit at the far edge. *@
                    var timeClass = i % 2 == 0 ? "bb:text-end" : "bb:text-start";
                    <BbTimelineItem IconColor="color" IconSize="TimelineSize.Small" ShowConnector="@(i < _entries.Count - 1)">
                        <IconContent>
                            @* IconContent replaces the whole icon, circle included - BbTimelineIcon
                               puts the circle (and IconColor's color) back. *@
                            <BbTimelineIcon Color="color" Size="TimelineSize.Small">
                                <LucideIcon Name="@(entry.Kind == PatientHistoryEntryKind.Note ? "message-square" : "activity")" Size="14" />
                            </BbTimelineIcon>
                        </IconContent>
                        <TimeContent>
                            <BbTimelineTime Class="@timeClass">@entry.Time.LocalDateTime.ToString("g")</BbTimelineTime>
                        </TimeContent>
                        <ChildContent>
                            <BbTimelineContent>
                                <BbTimelineHeader>
                                    <BbTimelineTitle>@entry.Title</BbTimelineTitle>
                                </BbTimelineHeader>
                                @if (!string.IsNullOrEmpty(entry.Description))
                                {
                                    <BbTimelineDescription>
                                        @if (entry.Kind == PatientHistoryEntryKind.Note)
                                        {
                                            @RenderNote(entry.Description)
                                        }
                                        else
                                        {
                                            @entry.Description
                                        }
                                    </BbTimelineDescription>
                                }
                            </BbTimelineContent>
                        </ChildContent>
                    </BbTimelineItem>
                }
            </BbTimeline>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required PatientListEntryDto Patient { get; set; }

    private List<PatientHistoryEntryDto> _entries = [];
    private bool _loading;
    private string? _loadedForSubjectId;
    private DateTimeOffset? _loadedForLastUpdated;

    private static MarkupString RenderNote(string html) => new(NoteHtmlSanitizer.Sanitize(html));

    protected override async Task OnParametersSetAsync()
    {
        // Also keyed on LastUpdated (not just the subject id) so a status change or note added
        // elsewhere in the same dialog session - both bump Patient.LastUpdated - refreshes this
        // timeline without requiring the dialog to be closed and reopened.
        if (Patient.ResearchSubjectId != _loadedForSubjectId || Patient.LastUpdated != _loadedForLastUpdated)
        {
            _loadedForSubjectId = Patient.ResearchSubjectId;
            _loadedForLastUpdated = Patient.LastUpdated;
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _loading = true;
        try
        {
            _entries = [.. await ResearchSubjectService.GetTimelineAsync(Patient.ResearchSubjectId, Patient.ResearchSubjectIdentifier)];
        }
        catch (Exception ex)
        {
            // Best-effort - an empty history is preferable to blocking on a fetch failure.
            Errors.Swallowed(ex, "load the patient's history");
            _entries = [];
        }
        finally
        {
            _loading = false;
        }
    }
}
