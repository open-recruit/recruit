@inject ResearchSubjectService ResearchSubjectService
@inject PatientRecordService PatientRecordService
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<BbSheet Open="Patient is not null" OpenChanged="HandleOpenChanged" Side="SheetSide.Right">
    <BbSheetContent Class="bb:w-full bb:overflow-y-auto" style="max-width: 46rem;" ShowClose="true">
        @if (Patient is not null)
        {
            <BbSheetHeader>
                @if (!string.IsNullOrEmpty(Acronym))
                {
                    <div class="bb:flex bb:items-center bb:gap-2 bb:pb-3">
                        <span class="bb:text-muted-foreground">
                            <LucideIcon Name="flask-conical" Size="16" />
                        </span>
                        <span class="bb:text-sm bb:font-semibold bb:text-foreground">@Acronym</span>
                        @if (!string.IsNullOrEmpty(StudyTitle))
                        {
                            <span class="bb:truncate bb:text-sm bb:text-muted-foreground">@StudyTitle</span>
                        }
                    </div>
                    <BbSeparator />
                }
                <div class="bb:mt-3 bb:flex bb:items-end bb:gap-2">
                    <BbSheetTitle style="line-height: 1;">@Patient.DisplayName</BbSheetTitle>
                    <span class="bb:text-sm bb:font-normal bb:text-muted-foreground" style="line-height: 1;">
                        @(Patient.Age is not null ? Localizer["App.PatientDialog.AgeYo", Patient.Age] : Localizer["App.Common.AgeUnknown"])
                        &middot; @(Patient.Gender is not null ? Localizer[GenderDisplay.GetKey(Patient.Gender)].Value : Localizer["App.Common.GenderUnknown"].Value)
                    </span>
                </div>
                @if (!string.IsNullOrEmpty(Patient.LastKnownLocation))
                {
                    <BbSheetDescription>@Patient.LastKnownLocation</BbSheetDescription>
                }
            </BbSheetHeader>

            <BbTabs DefaultValue="details" Class="bb:mt-4">
                <BbTabsList>
                    <BbTabsTrigger Value="details">@Localizer["App.PatientDialog.TabDetails"]</BbTabsTrigger>
                    <BbTabsTrigger Value="history">@Localizer["App.PatientDialog.TabHistory"]</BbTabsTrigger>
                </BbTabsList>
                <BbTabsContent Value="details">
                    <div class="bb:space-y-4">
                        @if (!string.IsNullOrEmpty(Patient.Phone) || !string.IsNullOrEmpty(Patient.Email))
                        {
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.Patient.Contact"]</span>
                                <div class="bb:mt-2 bb:space-y-1 bb:text-sm">
                                    @if (!string.IsNullOrEmpty(Patient.Phone))
                                    {
                                        <p>@Patient.Phone</p>
                                    }
                                    @if (!string.IsNullOrEmpty(Patient.Email))
                                    {
                                        <p>@Patient.Email</p>
                                    }
                                </div>
                            </div>
                        }

                        <div>
                            <div class="bb:flex bb:items-center bb:justify-between bb:gap-3">
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.Patient.RecruitmentStatus"]</span>
                                <SaveStatusIndicator Saving="_statusSaving" />
                            </div>
                            @if (CanEdit)
                            {
                                <BbRadioGroup TValue="string" Value="@Patient.Status" ValueChanged="OnStatusChangedInternal"
                                              Disabled="_statusSaving"
                                              Class="bb:mt-3 bb:flex bb:flex-row bb:flex-wrap bb:items-center">
                                    @foreach (var status in StatusOptions)
                                    {
                                        <BbRadioGroupItem TValue="string" Value="@status" Label="@Localizer[StatusDisplay.GetKey(status)].Value" />
                                    }
                                </BbRadioGroup>
                            }
                            else
                            {
                                <div class="bb:mt-2">
                                    <StatusBadge Status="@Patient.Status" />
                                </div>
                            }
                        </div>

                        <BbSeparator />

                        @if (_criteriaLoading)
                        {
                            <div class="bb:space-y-2">
                                <BbSkeleton Class="bb:h-5 bb:w-full" />
                                <BbSkeleton Class="bb:h-5 bb:w-full" />
                            </div>
                        }
                        else if (_criteria.Count > 0)
                        {
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.Patient.EligibilityCriteria"]</span>
                                <ul class="bb:mt-2 bb:space-y-1.5 bb:text-sm">
                                    @foreach (var criterion in _criteria)
                                    {
                                        <li class="bb:flex bb:items-center bb:gap-2">
                                            <CriterionStatusIcon Met="criterion.Met" Indeterminate="criterion.Indeterminate" Note="criterion.Note" />
                                            <span>@criterion.DisplayText</span>
                                        </li>
                                    }
                                </ul>
                            </div>

                            <BbSeparator />
                        }

                        @if (TrialIdentifier is not null)
                        {
                            <PatientNotesSection Patient="Patient" TrialIdentifier="TrialIdentifier" CanEdit="CanEdit" />
                        }
                    </div>
                </BbTabsContent>
                <BbTabsContent Value="history">
                    <PatientHistorySection Patient="Patient" />
                </BbTabsContent>
            </BbTabs>
        }
    </BbSheetContent>
</BbSheet>

@code {
    [Parameter]
    public PatientListEntryDto? Patient { get; set; }

    [Parameter]
    public EventCallback<PatientListEntryDto?> PatientChanged { get; set; }

    [Parameter, EditorRequired]
    public required string Acronym { get; set; }

    [Parameter]
    public string? StudyTitle { get; set; }

    [Parameter]
    public TrialIdentifier? TrialIdentifier { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] StatusOptions = ["candidate", "screening", "eligible", "ineligible", "on-study", "withdrawn"];

    private ClaimsPrincipal _user = new();
    private bool _statusSaving;
    private IReadOnlyList<CriterionStatusDto> _criteria = [];
    private bool _criteriaLoading;
    private string? _loadedCriteriaForSubjectId;

    protected override async Task OnParametersSetAsync()
    {
        _user = await AuthStateTask.GetUserAsync();

        if (Patient is null)
        {
            return;
        }

        if (TrialIdentifier is not null && Patient.ResearchSubjectId != _loadedCriteriaForSubjectId)
        {
            _loadedCriteriaForSubjectId = Patient.ResearchSubjectId;
            await LoadEligibilityCriteriaAsync();
        }
    }

    private async Task LoadEligibilityCriteriaAsync()
    {
        if (Patient is null || TrialIdentifier is null)
        {
            return;
        }

        _criteriaLoading = true;
        try
        {
            _criteria = await PatientRecordService.GetEligibilityCriteriaStatusAsync(Patient.PatientId, TrialIdentifier);
        }
        catch
        {
            // Best-effort - an empty criteria list is preferable to blocking the dialog on a fetch failure.
            _criteria = [];
        }
        finally
        {
            _criteriaLoading = false;
        }
    }

    private async Task OnStatusChangedInternal(string newStatus)
    {
        if (Patient is null || TrialIdentifier is null)
        {
            return;
        }

        _statusSaving = true;
        StateHasChanged();

        try
        {
            var updatedAt = await ResearchSubjectService.UpdateStatusAsync(Patient.ResearchSubjectId, newStatus, TrialIdentifier, _user);
            Patient.Status = newStatus;
            Patient.LastUpdated = updatedAt ?? DateTimeOffset.UtcNow;
            Toast.Success(Localizer["App.Toast.StatusUpdated", Localizer[StatusDisplay.GetKey(newStatus)]], Localizer["App.Common.Saved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.Toast.StatusUpdateError"]);
        }
        finally
        {
            _statusSaving = false;
        }
    }

    private async Task Close() => await PatientChanged.InvokeAsync(null);

    private async Task HandleOpenChanged(bool open)
    {
        if (!open)
        {
            await Close();
        }
    }
}
