@using System.Reflection
@inherits LayoutComponentBase
@implements IDisposable
@inject BreadcrumbState BreadcrumbState
@inject NotificationInboxState NotificationInboxState
@inject IStringLocalizer<SharedResources> Localizer
@inject NavigationManager Navigation
@inject ThemeService ThemeService

<BbSidebarProvider CookieKey="@((string?)null)">
    <BbSidebar Collapsible="false">
        <BbSidebarHeader>
            <div class="bb:flex bb:h-12 bb:items-center bb:gap-2 bb:px-3">
                @* Decorative (empty alt): the "recruIT" text next to it already names the app. *@
                <img src="@Assets["img/mark-light.png"]" alt="" class="app-logo-light bb:h-7 bb:w-7" />
                <img src="@Assets["img/mark-dark.png"]" alt="" class="app-logo-dark bb:h-7 bb:w-7" />
                <span class="bb:text-sm bb:font-semibold">recruIT</span>
            </div>
        </BbSidebarHeader>
        <BbSidebarContent Class="bb:flex-1 bb:overflow-auto bb:px-2">
            <BbSidebarGroup>
                <BbSidebarGroupLabel>@Localizer["App.Nav.GroupMain"]</BbSidebarGroupLabel>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All">
                            <LucideIcon Name="flask-conical" Size="16" />
                            @Localizer["App.Nav.Trials"]
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/patients">
                            <LucideIcon Name="users" Size="16" />
                            @Localizer["App.Nav.Patients"]
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/notifications" Class="bb:justify-between">
                            <span class="bb:flex bb:items-center bb:gap-2">
                                <LucideIcon Name="bell" Size="16" />
                                @Localizer["App.Nav.Notifications"]
                            </span>
                            @if (NotificationInboxState.UnreadCount > 0)
                            {
                                <BbBadge Variant="BadgeVariant.Destructive">@(NotificationInboxState.UnreadCount > 9 ? "9+" : NotificationInboxState.UnreadCount.ToString())</BbBadge>
                            }
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                </BbSidebarMenu>
            </BbSidebarGroup>
            <AuthorizeView Policy="Admin">
                <BbSidebarGroup>
                    <BbSidebarGroupLabel>@Localizer["App.Nav.GroupAdmin"]</BbSidebarGroupLabel>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/admin/criteria">
                                <LucideIcon Name="clipboard-pen-line" Size="16" />
                                @Localizer["App.Nav.CriteriaManager"]
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/admin/notify-test">
                                <LucideIcon Name="mail-check" Size="16" />
                                @Localizer["App.Nav.NotificationTest"]
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/hangfire" target="_blank" rel="noopener noreferrer">
                                <LucideIcon Name="activity" Size="16" />
                                @Localizer["App.Nav.HangfireDashboard"]
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroup>
            </AuthorizeView>
        </BbSidebarContent>
        <BbSidebarFooter>
            <div class="bb:px-3 bb:py-2 bb:text-xs bb:text-muted-foreground">
                <BbTooltip Placement="PopoverPlacement.Top">
                    <BbTooltipTrigger AsChild="false">
                        <span>@AppVersionShort</span>
                    </BbTooltipTrigger>
                    <BbTooltipContent>@AppVersion</BbTooltipContent>
                </BbTooltip>
            </div>
        </BbSidebarFooter>
    </BbSidebar>

    <BbSidebarInset Class="bb:flex bb:min-w-0 bb:flex-col bb:bg-background">
        <header class="bb:flex bb:shrink-0 bb:items-center bb:justify-between bb:border-b bb:px-4 bb:py-3">
            <div class="bb:flex bb:items-center bb:gap-2">
                <BbSidebarTrigger Class="bb:h-8 bb:w-8 bb:md:hidden">
                    <LucideIcon Name="menu" Size="16" />
                </BbSidebarTrigger>
                <Breadcrumbs Items="BreadcrumbState.Items" />
            </div>
            <div class="bb:flex bb:items-center bb:gap-2">
                <button type="button" @onclick="ToggleTheme"
                        class="bb:rounded bb:p-1 bb:hover:bg-accent bb:hover:text-accent-foreground"
                        aria-label="@(ThemeService.IsDarkMode ? Localizer["App.Theme.SwitchToLight"] : Localizer["App.Theme.SwitchToDark"])">
                    <LucideIcon Name="@(ThemeService.IsDarkMode ? "sun" : "moon")" Size="16" />
                </button>
                <div class="bb:flex bb:items-center bb:gap-1 bb:text-xs bb:text-muted-foreground">
                    @for (var i = 0; i < SupportedCultures.Length; i++)
                    {
                        var culture = SupportedCultures[i];
                        <a href="@BuildCultureUrl(culture)" data-enhance-nav="false"
                           class="bb:rounded bb:px-1.5 bb:py-0.5 bb:uppercase bb:hover:bg-accent bb:hover:text-accent-foreground @(IsCurrentCulture(culture) ? "bb:font-semibold bb:text-foreground" : "")">
                            @culture
                        </a>
                        @if (i < SupportedCultures.Length - 1)
                        {
                            <span aria-hidden="true">|</span>
                        }
                    }
                </div>
                <AuthorizeView>
                    <Authorized>
                        <BbDropdownMenu>
                            <BbDropdownMenuTrigger AsChild="false" Class="bb:flex bb:items-center bb:gap-2 bb:rounded-md bb:p-1 bb:hover:bg-accent bb:hover:text-accent-foreground">
                                <BbAvatar Size="AvatarSize.Small">
                                    <BbAvatarFallback>@GetInitials(context.User)</BbAvatarFallback>
                                </BbAvatar>
                            </BbDropdownMenuTrigger>
                            <BbDropdownMenuContent Side="PopoverSide.Bottom" Align="PopoverAlign.End" Class="bb:w-64">
                                <BbDropdownMenuLabel>
                                    <div class="bb:flex bb:flex-col">
                                        <span class="bb:truncate bb:text-sm bb:font-medium">@GetFullName(context.User)</span>
                                        <span class="bb:truncate bb:text-xs bb:font-normal bb:text-muted-foreground">@GetEmail(context.User)</span>
                                    </div>
                                </BbDropdownMenuLabel>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuLabel Class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">
                                    @Localizer["App.User.Roles"]
                                </BbDropdownMenuLabel>
                                <div class="bb:px-2 bb:pb-2">
                                    @{
                                        var roles = GetRoles(context.User);
                                    }
                                    @if (roles.Count == 0)
                                    {
                                        <span class="bb:text-xs bb:text-muted-foreground">@Localizer["App.User.NoRoles"]</span>
                                    }
                                    else
                                    {
                                        <div class="bb:flex bb:flex-wrap bb:gap-1">
                                            @foreach (var role in roles)
                                            {
                                                <BbBadge Variant="BadgeVariant.Secondary">@role</BbBadge>
                                            }
                                        </div>
                                    }
                                </div>
                                <BbDropdownMenuSeparator />
                                <BbDropdownMenuItem OnClick="SignOut">
                                    <Icon><LucideIcon Name="log-out" Size="16" /></Icon>
                                    <ChildContent>@Localizer["App.Nav.SignOut"]</ChildContent>
                                </BbDropdownMenuItem>
                            </BbDropdownMenuContent>
                        </BbDropdownMenu>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/authentication/login" class="bb:text-sm">@Localizer["App.Nav.SignIn"]</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </header>
        <main class="bb:min-h-0 bb:flex-1 bb:overflow-auto bb:p-4">
            <ErrorBoundary>
                <ChildContent>
                    @Body
                </ChildContent>
                <ErrorContent>
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertTitle>@Localizer["App.ErrorBoundary.Title"]</BbAlertTitle>
                        <BbAlertDescription>
                            @Localizer["App.ErrorBoundary.Description"]
                        </BbAlertDescription>
                    </BbAlert>
                </ErrorContent>
            </ErrorBoundary>
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

<BbPortalHost />
<BbToastProvider />
<BbDialogProvider />

<div id="blazor-error-ui" data-nosnippet>
    @Localizer["App.BlazorError.Message"]
    <a href="." class="reload">@Localizer["App.BlazorError.Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private static readonly string[] SupportedCultures = ["de", "en"];

    private static readonly string AppVersion =
        Assembly.GetExecutingAssembly().GetCustomAttribute<AssemblyInformationalVersionAttribute>()?.InformationalVersion
        ?? Assembly.GetExecutingAssembly().GetName().Version?.ToString()
        ?? "unknown";

    private static readonly string AppVersionShort = AppVersion.Split('+')[0];

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbState.Changed += OnStateChanged;
        NotificationInboxState.Changed += OnStateChanged;

        try
        {
            var user = await AuthStateTask.GetUserAsync();
            await NotificationInboxState.RefreshAsync(user);
        }
        catch
        {
            // Best-effort - the nav item simply shows no badge if the count can't be computed
            // (including if AuthStateTask itself failed, e.g. a token-refresh error).
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // JS interop (localStorage/system-preference detection) isn't available during the
            // static prerender pass, only once the interactive circuit is attached - hence here
            // rather than OnInitializedAsync.
            await ThemeService.InitializeAsync();
            StateHasChanged();
        }
    }

    private async Task ToggleTheme()
    {
        await ThemeService.ToggleDarkModeAsync();
        StateHasChanged();
    }

    private bool IsCurrentCulture(string culture) =>
        string.Equals(System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName, culture, StringComparison.OrdinalIgnoreCase);

    private string BuildCultureUrl(string culture)
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);
        var redirectUri = Uri.EscapeDataString(string.IsNullOrEmpty(relativePath) ? "/" : $"/{relativePath}");
        return $"/culture/set?culture={culture}&redirectUri={redirectUri}";
    }

    private void OnStateChanged() => InvokeAsync(StateHasChanged);

    // forceLoad is required: a Blazor Server circuit has no HTTP response of its own to attach a
    // Set-Cookie header to, so signing out has to happen via a real navigation to the endpoint
    // that calls SignOutAsync (see Program.cs's /authentication/logout).
    private void SignOut() => Navigation.NavigateTo("/authentication/logout", forceLoad: true);

    private static string GetFullName(ClaimsPrincipal user) => user.GetDisplayName() ?? string.Empty;

    private static string GetEmail(ClaimsPrincipal user) => user.GetEmail() ?? string.Empty;

    private static List<string> GetRoles(ClaimsPrincipal user)
    {
        var roleClaimType = (user.Identity as ClaimsIdentity)?.RoleClaimType ?? ClaimTypes.Role;
        return [.. user.Claims.Where(c => c.Type == roleClaimType).Select(c => c.Value).Distinct()];
    }

    private static string GetInitials(ClaimsPrincipal user)
    {
        var source = GetFullName(user);
        if (string.IsNullOrWhiteSpace(source))
        {
            return "?";
        }

        var parts = source.Split([' ', '.', '_', '-'], StringSplitOptions.RemoveEmptyEntries);
        return parts.Length switch
        {
            0 => "?",
            1 => parts[0][..1].ToUpperInvariant(),
            _ => (parts[0][..1] + parts[^1][..1]).ToUpperInvariant(),
        };
    }

    public void Dispose()
    {
        BreadcrumbState.Changed -= OnStateChanged;
        NotificationInboxState.Changed -= OnStateChanged;
    }
}
