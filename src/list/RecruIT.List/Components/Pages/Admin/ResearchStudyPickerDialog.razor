@inject IStringLocalizer<SharedResources> Localizer
@inject ErrorReporter Errors
@inject IBbLocalizer BbLocalizer
@inject EligibilityCriteriaService CriteriaService

<div class="bb:flex bb:min-w-0 bb:flex-col bb:gap-4">
    @if (_initialLoading)
    {
        <div class="bb:flex bb:flex-col bb:items-center bb:justify-center bb:gap-3 bb:py-12 bb:text-sm bb:text-muted-foreground">
            <BbSpinner Size="SpinnerSize.Large" />
            <span>@BbLocalizer["DataView.Loading"]</span>
        </div>
    }
    else if (_errorMessage is not null)
    {
        <BbAlert Variant="AlertVariant.Danger">
            <BbAlertDescription>@_errorMessage</BbAlertDescription>
        </BbAlert>
    }
    else
    {
        @* BbDataView's own toolbar search has no debounce knob, and searching on every keystroke
           is a visible round trip in Blazor Server - so this filters client-side (same as
           BbDataView's own would, just debounced) and reuses its "DataView.SearchPlaceholder" key
           rather than adding a near-duplicate translation. *@
        <BbInput @bind-Value="_filter" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                 Placeholder="@BbLocalizer["DataView.SearchPlaceholder"]" />

        <BbDataView TItem="ResearchStudySummaryDto" Data="FilteredResults" ShowToolbar="false" ShowPagination="false"
                    EnableInfiniteScroll ScrollHeight="28rem" InitialPageSize="20"
                    Class="bb:min-w-0" ListClass="bb:min-w-0">
            <ListTemplate Context="study">
                <div class="bb:flex bb:w-full bb:min-w-0 bb:items-center bb:justify-between bb:gap-3 bb:rounded-md bb:border bb:p-3">
                    <div class="bb:min-w-0 bb:flex-1">
                        @if (!string.IsNullOrWhiteSpace(study.Acronym))
                        {
                            <div class="bb:truncate bb:text-base bb:font-semibold">@study.Acronym</div>
                            <div class="bb:truncate bb:text-xs bb:text-muted-foreground">@(study.Title ?? study.Id)</div>
                        }
                        else
                        {
                            <div class="bb:truncate bb:text-base bb:font-semibold">@(study.Title ?? study.Id)</div>
                        }
                    </div>
                    <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" Class="bb:shrink-0" OnClick="@(() => SelectAsync(study))">
                        @Localizer["App.CriteriaManager.SelectCriterionButton"]
                    </BbButton>
                </div>
            </ListTemplate>
        </BbDataView>
    }

    <div class="bb:flex bb:justify-end">
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CancelAsync">
            @Localizer["App.CriteriaManager.CancelButton"]
        </BbButton>
    </div>
</div>

@code {
    [CascadingParameter]
    public IDialogReference DialogReference { get; set; } = default!;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<ResearchStudySummaryDto> _results = [];
    private string _filter = string.Empty;
    private bool _initialLoading = true;
    private string? _errorMessage;

    private List<ResearchStudySummaryDto> FilteredResults => [.. _results.Where(MatchesFilter)];

    private bool MatchesFilter(ResearchStudySummaryDto study) =>
        string.IsNullOrWhiteSpace(_filter)
        || (study.Title?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
        || (study.Acronym?.Contains(_filter, StringComparison.OrdinalIgnoreCase) ?? false)
        || study.Id.Contains(_filter, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _results = [.. await CriteriaService.GetResearchStudiesAsync(await AuthStateTask.GetUserAsync())];
        }
        catch (Exception ex)
        {
            _errorMessage = Errors.Report(ex, "list the research studies");
        }
        finally
        {
            _initialLoading = false;
        }
    }

    private Task SelectAsync(ResearchStudySummaryDto study) =>
        DialogReference.CloseAsync(DialogResult.Ok(study));

    private Task CancelAsync() => DialogReference.CancelAsync();
}
