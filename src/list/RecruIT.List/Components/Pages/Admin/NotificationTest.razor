@page "/admin/notify-test"
@attribute [Authorize]
@using System.Net.Sockets
@using System.Text
@using MailKit.Net.Smtp
@inject NotificationSenderService SenderService
@inject NotificationTestService TestService
@inject NotificationSubscriptionService SubscriptionService
@inject ScreeningListService ScreeningListService
@inject IOptions<EmailNotificationOptions> MailerOptions
@inject ToastService Toast
@inject IJSRuntime JS
@inject BreadcrumbState BreadcrumbState
@inject NotificationInboxState NotificationInboxState
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.NotificationTest.PageTitle"]</PageTitle>

@if (!_isAdmin)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertDescription>@Localizer["App.Errors.NotAuthorizedAdminOnly"]</BbAlertDescription>
    </BbAlert>
}
else
{
    <BbCard>
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.NotificationTest.SettingsTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <dl class="bb:grid bb:grid-cols-1 bb:gap-y-2 bb:text-sm bb:sm:grid-cols-2">
                <div>
                    <dt class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.NotificationTest.SmtpHostLabel"]</dt>
                    <dd>@MailerOptions.Value.SmtpHost:@MailerOptions.Value.SmtpPort</dd>
                </div>
                <div>
                    <dt class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.NotificationTest.FromLabel"]</dt>
                    <dd>@MailerOptions.Value.From</dd>
                </div>
            </dl>
        </BbCardContent>
    </BbCard>

    <BbCard Class="bb:mt-6">
        <BbCardHeader>
            <BbCardTitle>@Localizer["App.NotificationTest.SendTitle"]</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            <p class="bb:mb-3 bb:text-sm bb:text-muted-foreground">@Localizer["App.NotificationTest.SendDescription"]</p>
            <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-3">
                <div class="bb:w-full bb:max-w-sm">
                    <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.NotificationTest.EmailLabel"]</label>
                    <BbInput @bind-Value="_recipientEmail" Type="InputType.Email" Placeholder="@Localizer["App.NotificationTest.EmailPlaceholder"]" Class="bb:mt-1" />
                </div>
                <BbButton Variant="ButtonVariant.Default" Loading="_sending" Disabled="@string.IsNullOrWhiteSpace(_recipientEmail)" OnClick="SendTestEmailAsync">
                    @Localizer["App.NotificationTest.SendButton"]
                </BbButton>
            </div>
        </BbCardContent>
    </BbCard>

    @if (_failure is not null)
    {
        <BbAlert Variant="AlertVariant.Danger" Class="bb:mt-6">
            <BbAlertTitle>@Localizer["App.NotificationTest.SendErrorTitle"]</BbAlertTitle>
            <BbAlertDescription>
                <p class="bb:break-all">@_failure.Message</p>
                <dl class="bb:mt-3 bb:grid bb:grid-cols-1 bb:gap-y-2 bb:text-sm bb:sm:grid-cols-2">
                    @foreach (var (label, value) in _failure.Details)
                    {
                        <div>
                            <dt class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide">@label</dt>
                            <dd class="bb:break-all bb:font-mono">@value</dd>
                        </div>
                    }
                </dl>
            </BbAlertDescription>
        </BbAlert>

        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <div class="bb:flex bb:items-center bb:justify-between bb:gap-3">
                    <BbCardTitle>@Localizer["App.NotificationTest.ExceptionTitle"]</BbCardTitle>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => CopyAsync(_failure.Exception))">
                        <LucideIcon Name="copy" Size="16" />
                        @Localizer["App.NotificationTest.Copy"]
                    </BbButton>
                </div>
            </BbCardHeader>
            <BbCardContent>
                <textarea readonly class="diagnostic-textarea bb:rounded-md bb:border bb:p-3" aria-label="@Localizer["App.NotificationTest.ExceptionTitle"]">@_failure.Exception</textarea>
            </BbCardContent>
        </BbCard>
    }

    @if (_transcript is not null)
    {
        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <div class="bb:flex bb:items-center bb:justify-between bb:gap-3">
                    <div>
                        <BbCardTitle>@Localizer["App.NotificationTest.TranscriptTitle"]</BbCardTitle>
                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">@Localizer["App.NotificationTest.TranscriptDescription"]</p>
                    </div>
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="bb:shrink-0" OnClick="@(() => CopyAsync(_transcript))">
                        <LucideIcon Name="copy" Size="16" />
                        @Localizer["App.NotificationTest.Copy"]
                    </BbButton>
                </div>
            </BbCardHeader>
            <BbCardContent>
                @* Expanded straight away when the send failed - that's when the transcript matters
                   most; collapsed after a success, where it's only for "sent but never arrived". *@
                <details open="@(_failure is not null)">
                    <summary class="bb:cursor-pointer bb:text-sm">@Localizer["App.NotificationTest.TranscriptToggle"]</summary>
                    <textarea readonly class="diagnostic-textarea bb:mt-3 bb:rounded-md bb:border bb:p-3" aria-label="@Localizer["App.NotificationTest.TranscriptTitle"]">@(_transcript.Length > 0 ? _transcript : Localizer["App.NotificationTest.TranscriptEmpty"].Value)</textarea>
                </details>
            </BbCardContent>
        </BbCard>
    }

    @if (_simulationAvailable)
    {
        <BbCard Class="bb:mt-6">
            <BbCardHeader>
                <BbCardTitle>@Localizer["App.NotificationTest.SimulateTitle"]</BbCardTitle>
            </BbCardHeader>
            <BbCardContent>
                <p class="bb:mb-3 bb:text-sm bb:text-muted-foreground">@Localizer["App.NotificationTest.SimulateDescription"]</p>
                @if (_simulationError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_simulationError</BbAlertDescription>
                    </BbAlert>
                }
                else if (_trials is null)
                {
                    <BbSkeleton Class="bb:h-9 bb:w-full bb:max-w-sm" />
                }
                else if (_trials.Count == 0)
                {
                    <p class="bb:text-sm">@Localizer["App.NotificationTest.NoTrials"]</p>
                }
                else
                {
                    <div class="bb:flex bb:flex-wrap bb:items-end bb:gap-3">
                        <div class="bb:w-full bb:max-w-xs">
                            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.NotificationTest.TrialLabel"]</label>
                            <BbSelect TValue="string" Value="_selectedListId" ValueChanged="OnTrialChangedAsync" Options="TrialOptions"
                                      Placeholder="@Localizer["App.NotificationTest.TrialPlaceholder"]" AriaLabel="@Localizer["App.NotificationTest.TrialLabel"]" Class="bb:mt-1" />
                        </div>
                        <div class="bb:w-full bb:max-w-xs">
                            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.NotificationTest.PatientLabel"]</label>
                            <BbSelect TValue="string" @bind-Value="_selectedSubjectId" Options="PatientOptions" Disabled="@(_patients is not { Count: > 0 })"
                                      Placeholder="@Localizer["App.NotificationTest.PatientPlaceholder"]" AriaLabel="@Localizer["App.NotificationTest.PatientLabel"]" Class="bb:mt-1" />
                        </div>
                        <BbButton Variant="ButtonVariant.Default" Loading="_reRecommending" Disabled="@(_selectedSubjectId is null)" OnClick="ReRecommendAsync">
                            @Localizer["App.NotificationTest.ReRecommendButton"]
                        </BbButton>
                    </div>

                    @if (_selectedTrial is not null)
                    {
                        <div class="bb:mt-3 bb:space-y-2 bb:text-sm">
                            @if (_patients is { Count: 0 })
                            {
                                <p>@Localizer["App.NotificationTest.NoPatients"]</p>
                            }
                            <p class="bb:text-muted-foreground">@Localizer["App.NotificationTest.SubscriberCount", _subscriberCount]</p>
                            @if (!_subscribed)
                            {
                                <BbAlert Variant="AlertVariant.Warning">
                                    <BbAlertDescription>
                                        @Localizer["App.NotificationTest.NotSubscribed"]
                                        <a href="/trials/@_selectedTrial.ListId/patients" class="bb:ms-1 bb:font-medium bb:underline">@Localizer["App.NotificationTest.OpenScreeningList"]</a>
                                    </BbAlertDescription>
                                </BbAlert>
                            }
                        </div>
                    }
                }

                @if (_reRecommendResult is not null)
                {
                    <BbAlert Variant="@(_reRecommendResult.NotificationCount > 0 ? AlertVariant.Success : AlertVariant.Warning)" Class="bb:mt-4">
                        @if (_reRecommendResult.NotificationCount > 0)
                        {
                            <BbAlertTitle>@Localizer["App.NotificationTest.ReRecommendedTitle"]</BbAlertTitle>
                            <BbAlertDescription>
                                <p>@Localizer["App.NotificationTest.ReRecommendedDescription", _reRecommendResult.PatientDisplayName, _reRecommendResult.Trial.StudyAcronym]</p>
                                <p class="bb:mt-1 bb:flex bb:flex-wrap bb:gap-4">
                                    <a href="/notifications" class="bb:font-medium bb:underline">@Localizer["App.NotificationTest.OpenNotifications"]</a>
                                    <a href="/trials/@_reRecommendResult.Trial.ListId/patients" class="bb:font-medium bb:underline">@Localizer["App.NotificationTest.OpenScreeningList"]</a>
                                </p>
                            </BbAlertDescription>
                        }
                        else
                        {
                            <BbAlertTitle>@Localizer["App.NotificationTest.ReRecommendNoEventTitle"]</BbAlertTitle>
                            <BbAlertDescription>@Localizer["App.NotificationTest.ReRecommendNoEventDescription"]</BbAlertDescription>
                        }
                    </BbAlert>
                }

                <BbSeparator Class="bb:my-6" />
                <p class="bb:mb-3 bb:text-sm bb:text-muted-foreground">@Localizer["App.NotificationTest.SendDueDescription"]</p>
                <BbButton Variant="ButtonVariant.Outline" OnClick="SendDueEmailsNow">
                    @Localizer["App.NotificationTest.SendDueButton"]
                </BbButton>
            </BbCardContent>
        </BbCard>
    }
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    /// <summary>What the admin needs to debug a failed send, captured once at failure time.</summary>
    private sealed record SendFailure(
        string Message,
        IReadOnlyList<(string Label, string Value)> Details,
        string Exception
    );

    private sealed record ReRecommendResult(TrialSummaryDto Trial, string PatientDisplayName, int NotificationCount);

    private ClaimsPrincipal _user = new();
    private bool _isAdmin;
    private bool _sending;
    private string _recipientEmail = string.Empty;
    private SendFailure? _failure;
    private string? _transcript;

    /// <summary>NotificationTestService.IsAvailable - Notifications:Testing:Enabled on top of the admin role.</summary>
    private bool _simulationAvailable;
    private string? _simulationError;
    private List<TrialSummaryDto>? _trials;
    private string? _selectedListId;
    private TrialSummaryDto? _selectedTrial;
    private List<PatientListEntryDto>? _patients;
    private string? _selectedSubjectId;
    private int _subscriberCount;
    private bool _subscribed;
    private bool _reRecommending;
    private ReRecommendResult? _reRecommendResult;

    private IEnumerable<SelectOption<string>> TrialOptions =>
        (_trials ?? []).Select(t => new SelectOption<string>(t.ListId, t.StudyAcronym));

    private IEnumerable<SelectOption<string>> PatientOptions =>
        (_patients ?? []).Select(p => new SelectOption<string>(p.ResearchSubjectId, p.DisplayName));

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthStateTask.GetUserAsync();
        _isAdmin = TrialAccessService.IsAdmin(_user);
        _recipientEmail = _user.GetEmail() ?? string.Empty;

        BreadcrumbState.Set(
            new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"),
            new BreadcrumbItem(Localizer["App.NotificationTest.Breadcrumb"]));

        _simulationAvailable = TestService.IsAvailable(_user);
        if (_simulationAvailable)
        {
            try
            {
                _trials = [.. await ScreeningListService.GetAccessibleTrialsAsync(_user)];
            }
            catch (Exception)
            {
                _simulationError = Localizer["App.NotificationTest.LoadError"];
            }
        }
    }

    private async Task OnTrialChangedAsync(string? listId)
    {
        _selectedListId = listId;
        _selectedTrial = null;
        _patients = null;
        _selectedSubjectId = null;
        _reRecommendResult = null;
        if (listId is null)
        {
            return;
        }

        try
        {
            var (summary, patients) = await ScreeningListService.GetListWithPatientsAsync(listId, _user);
            _patients = [.. patients];
            _subscriberCount = await TestService.CountSubscribersAsync(summary.TrialIdentifier);
            _subscribed = await SubscriptionService.GetAsync(_user, summary.TrialIdentifier) is not null;
            _selectedTrial = summary;
        }
        catch (Exception)
        {
            _simulationError = Localizer["App.NotificationTest.LoadError"];
        }
    }

    private async Task ReRecommendAsync()
    {
        if (_selectedTrial is null || _selectedSubjectId is null || _reRecommending)
        {
            return;
        }

        var trial = _selectedTrial;
        var patient = _patients?.FirstOrDefault(p => p.ResearchSubjectId == _selectedSubjectId);
        _reRecommending = true;
        _reRecommendResult = null;
        try
        {
            var count = await TestService.ReRecommendAsync(trial.ListId, _selectedSubjectId, _user);
            _reRecommendResult = new ReRecommendResult(trial, patient is null ? _selectedSubjectId : patient.DisplayName, count);
            await NotificationInboxState.RefreshAsync(_user);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.NotificationTest.ReRecommendErrorTitle"]);
        }
        finally
        {
            _reRecommending = false;
        }
    }

    private void SendDueEmailsNow()
    {
        try
        {
            TestService.SendDueEmailsNow(_user);
            Toast.Success(Localizer["App.NotificationTest.SendDueQueuedToast"], Localizer["App.NotificationTest.SendDueButton"]);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.NotificationTest.SendDueButton"]);
        }
    }

    private async Task SendTestEmailAsync()
    {
        if (string.IsNullOrWhiteSpace(_recipientEmail))
        {
            return;
        }

        var recipient = _recipientEmail.Trim();
        _sending = true;
        _failure = null;
        _transcript = null;

        using var protocolLog = new MemoryStream();
        try
        {
            await SenderService.SendTestEmailAsync(recipient, protocolLog);
            Toast.Success(Localizer["App.NotificationTest.SentToast"], Localizer["App.Common.Saved"]);
        }
        catch (Exception ex)
        {
            _failure = DescribeFailure(ex, recipient);
            Toast.Error(ex.Message, Localizer["App.NotificationTest.SendErrorTitle"]);
        }
        finally
        {
            _transcript = CollapseMessageBody(Encoding.UTF8.GetString(protocolLog.ToArray()));
            _sending = false;
        }
    }

    private SendFailure DescribeFailure(Exception ex, string recipient)
    {
        var options = MailerOptions.Value;
        var details = new List<(string Label, string Value)>
        {
            (Localizer["App.NotificationTest.ExceptionTypeLabel"], ex.GetType().FullName ?? ex.GetType().Name),
            (Localizer["App.NotificationTest.SmtpHostLabel"], $"{options.SmtpHost}:{options.SmtpPort}"),
            (Localizer["App.NotificationTest.FromLabel"], options.From),
            (Localizer["App.NotificationTest.EmailLabel"], recipient),
        };

        if (ex is SmtpCommandException command)
        {
            // The server's own verdict - e.g. 535 for rejected credentials, 550 for a refused mailbox.
            details.Add((Localizer["App.NotificationTest.SmtpStatusCodeLabel"], $"{(int)command.StatusCode} ({command.StatusCode})"));
            details.Add((Localizer["App.NotificationTest.SmtpErrorCodeLabel"], command.ErrorCode.ToString()));
            if (command.Mailbox is not null)
            {
                details.Add((Localizer["App.NotificationTest.MailboxLabel"], command.Mailbox.Address));
            }
        }

        // Connection failures (refused, DNS, timeout) usually arrive wrapped, so look past the
        // outermost exception for the socket-level cause.
        for (var inner = ex; inner is not null; inner = inner.InnerException)
        {
            if (inner is SocketException socket)
            {
                details.Add((Localizer["App.NotificationTest.SocketErrorLabel"], socket.SocketErrorCode.ToString()));
                break;
            }
        }

        // Exception.ToString() covers the type, message and stack trace of the whole inner
        // exception chain - everything a bug report or a support ticket would need.
        return new SendFailure(ex.Message, details, ex.ToString());
    }

    /// <summary>
    /// The transcript otherwise carries the whole rendered HTML body (several hundred lines of
    /// MJML output) between the DATA command's headers and its terminating "." - irrelevant for
    /// debugging delivery and burying the server's replies that come after it. Keeps the headers
    /// (From/To/Subject are useful) and replaces only the body with a line count.
    /// </summary>
    private string CollapseMessageBody(string transcript)
    {
        var lines = transcript.Split('\n');
        var result = new List<string>(lines.Length);
        var state = 0; // 0 = SMTP commands, 1 = message headers, 2 = message body
        var bodyLines = 0;
        foreach (var rawLine in lines)
        {
            var line = rawLine.TrimEnd('\r');
            if (state == 0 && line.StartsWith("S: 354", StringComparison.Ordinal))
            {
                state = 1;
            }
            else if (state == 1 && line == "C: ")
            {
                state = 2;
            }
            else if (state == 2)
            {
                if (line != "C: .")
                {
                    bodyLines++;
                    continue;
                }

                result.Add($"C: [{Localizer["App.NotificationTest.TranscriptBodyOmitted", bodyLines]}]");
                state = 0;
                bodyLines = 0;
            }

            result.Add(line);
        }

        return string.Join('\n', result);
    }

    private async Task CopyAsync(string text)
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
            Toast.Success(Localizer["App.NotificationTest.CopiedToast"], Localizer["App.NotificationTest.Copy"]);
        }
        catch (JSException)
        {
            // The clipboard API needs a secure context (HTTPS or localhost) and permission - the
            // text is still right there to select by hand.
            Toast.Error(Localizer["App.NotificationTest.CopyFailedToast"], Localizer["App.NotificationTest.Copy"]);
        }
    }
}
