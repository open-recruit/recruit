@inject IStringLocalizer<SharedResources> Localizer

<div class="bb:flex bb:flex-col bb:gap-4">
    <BbInput @bind-Value="_search" @bind:event="oninput"
             Placeholder="@Localizer["App.CriteriaManager.LibrarySearchPlaceholder"]" />

    @if (FilteredLibraries.Count == 0)
    {
        <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.CriteriaManager.NoLibrariesMessage"]</p>
    }
    else
    {
        <div class="bb:flex bb:flex-col bb:gap-3 bb:overflow-auto">
            @foreach (var library in FilteredLibraries)
            {
                <div class="bb:rounded-md bb:border bb:p-3">
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                        <div>
                            <div class="bb:font-medium">@(library.Title ?? library.Id)</div>
                            @if (!string.IsNullOrWhiteSpace(library.Name))
                            {
                                <div class="bb:text-xs bb:text-muted-foreground">@library.Name</div>
                            }
                            <SqlDialectBadges Dialects="library.SqlDialects" />
                        </div>
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" OnClick="@(() => SelectAsync(library))">
                            @Localizer["App.CriteriaManager.SelectCriterionButton"]
                        </BbButton>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(library.Description))
                    {
                        <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">@library.Description</p>
                    }
                    @if (!string.IsNullOrWhiteSpace(library.Sql))
                    {
                        <details class="bb:mt-3">
                            <summary class="bb:cursor-pointer bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground bb:hover:text-foreground">
                                @Localizer["App.CriteriaManager.CriterionSqlLabel"]
                            </summary>
                            <pre class="bb:mt-2 bb:max-h-48 bb:overflow-auto bb:rounded-md bb:border bb:bg-muted bb:p-3 bb:text-xs"><code>@library.Sql</code></pre>
                        </details>
                    }
                </div>
            }
        </div>
    }

    <div class="bb:flex bb:justify-end">
        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="CancelAsync">
            @Localizer["App.CriteriaManager.CancelButton"]
        </BbButton>
    </div>
</div>

@code {
    [Parameter]
    public IReadOnlyList<LibrarySummaryDto> Libraries { get; set; } = [];

    [CascadingParameter]
    public IDialogReference DialogReference { get; set; } = default!;

    private string _search = string.Empty;

    private List<LibrarySummaryDto> FilteredLibraries => [.. Libraries.Where(MatchesSearch)];

    private bool MatchesSearch(LibrarySummaryDto library) =>
        string.IsNullOrWhiteSpace(_search)
        || (library.Title?.Contains(_search, StringComparison.OrdinalIgnoreCase) ?? false)
        || library.Id.Contains(_search, StringComparison.OrdinalIgnoreCase);

    private Task SelectAsync(LibrarySummaryDto library) =>
        DialogReference.CloseAsync(DialogResult.Ok(library));

    private Task CancelAsync() => DialogReference.CancelAsync();
}
