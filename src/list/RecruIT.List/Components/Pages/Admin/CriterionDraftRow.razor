@inject IStringLocalizer<SharedResources> Localizer

<div class="bb:rounded-md bb:border bb:p-3">
    <div class="bb:flex bb:flex-wrap bb:items-start bb:justify-between bb:gap-2">
        <div class="bb:flex bb:flex-1 bb:items-start bb:gap-3">
            <span class="bb:mt-1 bb:shrink-0 bb:text-xs bb:font-medium bb:tabular-nums bb:text-muted-foreground">@Index.ToString("D2")</span>
            <div class="bb:min-w-0 bb:flex-1">
                @if (IsFromLibrary)
                {
                    <p class="bb:text-sm">@Criterion.DisplayText</p>
                }
                else
                {
                    <BbInput @bind-Value="Criterion.DisplayText" @bind:event="oninput" @bind:after="OnChanged.InvokeAsync"
                             Required="true" Placeholder="@Localizer["App.CriteriaManager.CriterionDisplayTextPlaceholder"]" />
                    <p class="bb:mt-1 bb:text-xs bb:text-muted-foreground">
                        @Localizer["App.CriteriaManager.CriterionNamePreviewLabel"]: <code>@LibraryName</code>
                    </p>
                }
            </div>
        </div>
        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-1">
            <div class="bb:flex" role="group" aria-label="@Localizer["App.CriteriaManager.CriterionTypeGroupLabel"]">
                <BbButton Variant="@(Criterion.Exclude ? ButtonVariant.Outline : ButtonVariant.Secondary)" Size="ButtonSize.Small" OnClick="@(() => OnSetExclude.InvokeAsync(false))">
                    @Localizer["App.CriteriaManager.InclusionToggleLabel"]
                </BbButton>
                <BbButton Variant="@(Criterion.Exclude ? ButtonVariant.Secondary : ButtonVariant.Outline)" Size="ButtonSize.Small" OnClick="@(() => OnSetExclude.InvokeAsync(true))">
                    @Localizer["App.CriteriaManager.ExclusionToggleLabel"]
                </BbButton>
            </div>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="!CanMoveUp"
                      OnClick="OnMoveUp" title="@Localizer["App.CriteriaManager.MoveUpButton"]">
                <LucideIcon Name="chevron-up" Size="14" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="!CanMoveDown"
                      OnClick="OnMoveDown" title="@Localizer["App.CriteriaManager.MoveDownButton"]">
                <LucideIcon Name="chevron-down" Size="14" />
            </BbButton>
            <BbButton Variant="ButtonVariant.Destructive" Size="ButtonSize.Small" OnClick="OnRemove" title="@Localizer["App.CriteriaManager.RemoveCriterionButton"]">
                <LucideIcon Name="trash-2" Size="14" />
            </BbButton>
        </div>
    </div>

    @if (IsFromLibrary)
    {
        <SqlDisclosure Sql="@Criterion.Sql" />
    }
    else
    {
        <div class="bb:mt-3">
            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.CriteriaManager.CriterionDescriptionLabel"]</label>
            <textarea class="bb:mt-1 bb:block bb:w-full bb:rounded-md bb:border bb:bg-background bb:p-2 bb:text-sm" rows="2"
                      @bind="Criterion.Description" @bind:event="oninput" @bind:after="OnChanged.InvokeAsync"></textarea>
        </div>
        <div class="bb:mt-3">
            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.CriteriaManager.CriterionSqlDialectLabel"]</label>
            <BbSelect TValue="SqlDialect" @bind-Value="Criterion.Dialect" @bind-Value:after="OnChanged.InvokeAsync" Class="bb:mt-1 bb:w-48">
                <BbSelectTrigger>
                    <BbSelectValue />
                </BbSelectTrigger>
                <BbSelectContent>
                    @foreach (var dialect in Enum.GetValues<SqlDialect>())
                    {
                        <BbSelectItem TValue="SqlDialect" Value="@dialect" Text="@dialect.DisplayName()" />
                    }
                </BbSelectContent>
            </BbSelect>
        </div>
        <div class="bb:mt-3">
            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.CriteriaManager.CriterionSqlLabel"]</label>
            <textarea class="bb:mt-1 bb:block bb:w-full bb:rounded-md bb:border bb:bg-background bb:p-2 bb:font-mono bb:text-xs" rows="4"
                      @bind="Criterion.Sql" @bind:event="oninput" @bind:after="OnChanged.InvokeAsync"></textarea>
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public required CriterionDraft Criterion { get; set; }

    /// <summary>1-based position within the unified criteria list, shown as "01", "02", ...</summary>
    [Parameter, EditorRequired]
    public required int Index { get; set; }

    [Parameter]
    public bool CanMoveUp { get; set; }

    [Parameter]
    public bool CanMoveDown { get; set; }

    [Parameter]
    public EventCallback OnMoveUp { get; set; }

    [Parameter]
    public EventCallback OnMoveDown { get; set; }

    [Parameter]
    public EventCallback<bool> OnSetExclude { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    /// <summary>
    /// Raised after any in-place edit to this row's own bound fields (Title/Description/Sql). A
    /// child component's @bind only triggers *its own* re-render, not the parent's - without this,
    /// CriteriaManager's live Preview panel (which reads the same, mutated CriterionDraft instance)
    /// would silently go stale while typing, only catching up on some unrelated parent-level event
    /// like adding/removing/moving a criterion.
    /// </summary>
    [Parameter]
    public EventCallback OnChanged { get; set; }

    /// <summary>Library-backed criteria show their (read-only) source SQL; ad hoc ones are edited inline.</summary>
    private bool IsFromLibrary => !string.IsNullOrWhiteSpace(Criterion.ExistingLibraryReference);

    /// <summary>Live preview of the Library.name a new ad hoc criterion would be saved with.</summary>
    private string LibraryName => Slug.Create(Criterion.DisplayText);
}
