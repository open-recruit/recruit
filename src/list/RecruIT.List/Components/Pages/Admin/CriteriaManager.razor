@page "/admin/criteria"
@attribute [Authorize]
@inject EligibilityCriteriaService CriteriaService
@inject BreadcrumbState BreadcrumbState
@inject DialogService DialogService
@inject ToastService Toast
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.CriteriaManager.PageTitle"]</PageTitle>

@if (!_isAdmin)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertDescription>@Localizer["App.Errors.NotAuthorizedAdminOnly"]</BbAlertDescription>
    </BbAlert>
}
else
{
    <BbTabs DefaultValue="study">
        <BbTabsList>
            <BbTabsTrigger Value="study">@Localizer["App.CriteriaManager.StudyTabTitle"]</BbTabsTrigger>
            <BbTabsTrigger Value="library">@Localizer["App.CriteriaManager.LibraryTabTitle"] (@_libraries.Count)</BbTabsTrigger>
        </BbTabsList>

        <BbTabsContent Value="library">
            <BbCard Class="bb:mt-4">
                <BbCardHeader>
                    <BbCardTitle>@Localizer["App.CriteriaManager.LibrarySectionTitle"]</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <p class="bb:mb-3 bb:text-sm bb:text-muted-foreground">@Localizer["App.CriteriaManager.LibrarySectionDescription"]</p>

                    @if (_librariesLoading)
                    {
                        <BbSkeleton Class="bb:h-24 bb:w-full" />
                    }
                    else if (_libraryLoadErrorMessage is not null)
                    {
                        <BbAlert Variant="AlertVariant.Danger">
                            <BbAlertDescription>@_libraryLoadErrorMessage</BbAlertDescription>
                        </BbAlert>
                    }
                    else
                    {
                        <BbInput @bind-Value="_librarySearch" @bind:event="oninput"
                                 Placeholder="@Localizer["App.CriteriaManager.LibrarySearchPlaceholder"]" Class="bb:mb-4 bb:max-w-sm" />

                        @if (FilteredLibraries.Count == 0)
                        {
                            <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.CriteriaManager.NoLibrariesMessage"]</p>
                        }
                        else
                        {
                            <div class="bb:flex bb:flex-col bb:gap-4">
                                @foreach (var library in FilteredLibraries)
                                {
                                    <div class="bb:rounded-md bb:border bb:p-3">
                                        <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                                            <div>
                                                <div class="bb:font-medium">@(library.Title ?? library.Id)</div>
                                                @if (!string.IsNullOrWhiteSpace(library.Name))
                                                {
                                                    <div class="bb:text-xs bb:text-muted-foreground">@library.Name</div>
                                                }
                                                <SqlDialectBadges Dialects="library.SqlDialects" />
                                            </div>
                                            <div class="bb:flex bb:flex-col bb:items-end bb:gap-1">
                                                @if (library.Status is not null)
                                                {
                                                    <BbBadge Variant="BadgeVariant.Secondary">@library.Status</BbBadge>
                                                }
                                                @if (library.LastUpdated is not null)
                                                {
                                                    <span class="bb:text-xs bb:text-muted-foreground">
                                                        @Localizer["App.CriteriaManager.LastUpdatedLabel"]: @library.LastUpdated.Value.LocalDateTime.ToString("g")
                                                    </span>
                                                }
                                            </div>
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(library.Description))
                                        {
                                            <p class="bb:mt-1 bb:text-sm bb:text-muted-foreground">@library.Description</p>
                                        }
                                        <div class="bb:mt-2 bb:flex bb:flex-wrap bb:items-center bb:gap-1 bb:text-xs bb:text-muted-foreground">
                                            <span>@(Localizer["App.CriteriaManager.LibraryUsedByLabel"]):</span>
                                            @if (library.UsedByStudyDisplayNames.Count == 0)
                                            {
                                                <span>@Localizer["App.CriteriaManager.LibraryNotUsedLabel"]</span>
                                            }
                                            else
                                            {
                                                @foreach (var studyName in library.UsedByStudyDisplayNames)
                                                {
                                                    <BbBadge Variant="BadgeVariant.Outline">@studyName</BbBadge>
                                                }
                                            }
                                        </div>
                                        @if (!string.IsNullOrWhiteSpace(library.Sql))
                                        {
                                            <details class="bb:mt-3">
                                                <summary class="bb:cursor-pointer bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground bb:hover:text-foreground">
                                                    @Localizer["App.CriteriaManager.CriterionSqlLabel"]
                                                </summary>
                                                <pre class="bb:mt-2 bb:max-h-64 bb:overflow-auto bb:rounded-md bb:border bb:bg-muted bb:p-3 bb:text-xs"><code>@library.Sql</code></pre>
                                            </details>
                                        }
                                    </div>
                                }
                            </div>
                        }
                    }
                </BbCardContent>
            </BbCard>
        </BbTabsContent>

        <BbTabsContent Value="study">
            <BbCard Class="bb:mt-4">
                <BbCardHeader>
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                        <BbCardTitle>@Localizer["App.CriteriaManager.StudySectionTitle"]</BbCardTitle>
                        @if (_studyDraft.ExistingStudyId is null)
                        {
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="OpenResearchStudyPickerAsync">
                                <Icon><LucideIcon Name="search" Size="14" /></Icon>
                                <ChildContent>@Localizer["App.CriteriaManager.UseExistingStudyButton"]</ChildContent>
                            </BbButton>
                        }
                        else
                        {
                            <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                                <BbBadge Variant="BadgeVariant.Secondary">@Localizer["App.CriteriaManager.ExistingStudyBadge"]</BbBadge>
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="ClearExistingStudy">
                                    @Localizer["App.CriteriaManager.UseNewStudyButton"]
                                </BbButton>
                            </div>
                        }
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <div class="bb:flex bb:flex-wrap bb:gap-3">
                        <div class="bb:flex-1">
                            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">
                                @Localizer["App.CriteriaManager.StudyTitleLabel"] <span class="bb:text-destructive">*</span>
                            </label>
                            <BbInput @bind-Value="_studyDraft.Title" Required="true" Disabled="@(_studyDraft.ExistingStudyId is not null)" Class="bb:mt-1" />
                        </div>
                        <div class="bb:w-full">
                            <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">
                                @Localizer["App.CriteriaManager.StudyAcronymLabel"] <span class="bb:text-destructive">*</span>
                            </label>
                            <BbInput @bind-Value="_studyDraft.Acronym" Required="true" Disabled="@(_studyDraft.ExistingStudyId is not null)" Class="bb:mt-1" />
                        </div>
                    </div>

                    <div class="bb:mt-4">
                        <label class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.CriteriaManager.StudyDescriptionLabel"]</label>
                        <textarea class="bb:mt-1 bb:block bb:w-full bb:rounded-md bb:border bb:bg-background bb:p-2 bb:text-sm" rows="3" disabled="@(_studyDraft.ExistingStudyId is not null)"
                                  @bind="_studyDraft.Description" @bind:event="oninput"></textarea>
                    </div>

                    <div class="bb:mt-4 bb:flex bb:items-start bb:gap-2">
                        <BbCheckbox @bind-Checked="_studyDraft.CreateEmptyScreeningList" Id="create-empty-screening-list" Class="bb:mt-0.5" />
                        <div>
                            <BbLabel For="create-empty-screening-list">@Localizer["App.CriteriaManager.CreateEmptyScreeningListLabel"]</BbLabel>
                            <p class="bb:text-xs bb:text-muted-foreground">@Localizer["App.CriteriaManager.CreateEmptyScreeningListDescription"]</p>
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>

            <BbCard Class="bb:mt-6">
                <BbCardHeader>
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                        <BbCardTitle>@Localizer["App.CriteriaManager.CriteriaSectionTitle"]</BbCardTitle>
                        @if (_criteria.Count > 0)
                        {
                            <span class="bb:text-sm bb:text-muted-foreground">
                                @Localizer["App.CriteriaManager.CriteriaSummary", InclusionCriteria.Count, ExclusionCriteria.Count]
                            </span>
                        }
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <div class="bb:mb-4 bb:flex bb:flex-wrap bb:items-center bb:gap-2">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="OpenLibraryPickerAsync">
                            <Icon><LucideIcon Name="library" Size="14" /></Icon>
                            <ChildContent>@Localizer["App.CriteriaManager.AddFromLibraryButton"]</ChildContent>
                        </BbButton>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="AddCriterion">
                            <Icon><LucideIcon Name="plus" Size="14" /></Icon>
                            <ChildContent>@Localizer["App.CriteriaManager.NewCriterionButton"]</ChildContent>
                        </BbButton>
                    </div>

                    @if (_studyCriteriaLoading)
                    {
                        <BbSkeleton Class="bb:h-24 bb:w-full" />
                    }
                    else if (_criteria.Count == 0)
                    {
                        <p class="bb:text-sm bb:text-muted-foreground">@Localizer["App.CriteriaManager.NoCriteriaMessage"]</p>
                    }
                    else
                    {
                        <div class="bb:flex bb:flex-col bb:gap-3">
                            @for (var i = 0; i < _criteria.Count; i++)
                            {
                                var criterion = _criteria[i];
                                var isFirst = i == 0;
                                var isLast = i == _criteria.Count - 1;
                                <CriterionDraftRow Index="i + 1" Criterion="criterion" CanMoveUp="!isFirst" CanMoveDown="!isLast"
                                                    OnMoveUp="@(() => MoveCriterion(criterion, -1))"
                                                    OnMoveDown="@(() => MoveCriterion(criterion, 1))"
                                                    OnSetExclude="@(exclude => SetCriterionExclude(criterion, exclude))"
                                                    OnRemove="@(() => RemoveCriterion(criterion))"
                                                    OnChanged="StateHasChanged" />
                            }
                        </div>
                    }
                </BbCardContent>
            </BbCard>

            <BbCard Class="bb:mt-6">
                <BbCardHeader>
                    <div class="bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-2">
                        <BbCardTitle>@Localizer["App.CriteriaManager.PreviewSectionTitle"]</BbCardTitle>
                        <BbButton Variant="ButtonVariant.Default" Size="ButtonSize.Small" Disabled="@(!CanSubmit)"
                                  Loading="_submitting" LoadingText="@Localizer["App.CriteriaManager.SubmittingButton"]"
                                  OnClick="SubmitAsync">
                            <Icon><LucideIcon Name="upload" Size="14" /></Icon>
                            <ChildContent>@Localizer["App.CriteriaManager.SubmitButton"]</ChildContent>
                        </BbButton>
                    </div>
                </BbCardHeader>
                <BbCardContent>
                    <p class="bb:mb-3 bb:text-sm bb:text-muted-foreground">@Localizer["App.CriteriaManager.PreviewDescription"]</p>
                    <pre class="bb:overflow-auto bb:rounded-md bb:border bb:bg-muted bb:p-3 bb:text-xs"><code>@PreviewJson</code></pre>
                </BbCardContent>
            </BbCard>
        </BbTabsContent>
    </BbTabs>
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private bool _isAdmin;
    private ClaimsPrincipal _user = new();

    private ResearchStudyDraft _studyDraft = new();
    private readonly List<CriterionDraft> _criteria = [];

    private List<LibrarySummaryDto> _libraries = [];
    private bool _librariesLoading = true;
    private string _librarySearch = string.Empty;
    private string? _libraryLoadErrorMessage;

    private bool _submitting;

    private bool _studyCriteriaLoading;

    /// <summary>The picked existing study's own criteria, dropped again if the study is cleared.</summary>
    private readonly List<CriterionDraft> _studyCriteria = [];

    private string PreviewJson => CriteriaService.BuildPreviewJson(_studyDraft, _criteria);

    /// <summary>
    /// A new study needs a Title and an Acronym (1..1 in the RecruitResearchStudy profile) to be
    /// worth submitting; an existing one is submitted unmodified. Never while an existing study's
    /// criteria are still loading: submitting replaces its enrollment with only the criteria listed
    /// here, so it would drop the ones not loaded yet.
    /// </summary>
    private bool CanSubmit =>
        !_submitting
        && !_studyCriteriaLoading
        && (
            _studyDraft.ExistingStudyId is not null
            || (
                !string.IsNullOrWhiteSpace(_studyDraft.Title)
                && !string.IsNullOrWhiteSpace(_studyDraft.Acronym)
            )
        );

    private List<LibrarySummaryDto> FilteredLibraries =>
        [.. _libraries.Where(MatchesLibrarySearch)];

    private List<CriterionDraft> InclusionCriteria => [.. _criteria.Where(c => !c.Exclude)];

    private List<CriterionDraft> ExclusionCriteria => [.. _criteria.Where(c => c.Exclude)];

    private bool MatchesLibrarySearch(LibrarySummaryDto library) =>
        string.IsNullOrWhiteSpace(_librarySearch)
        || (library.Title?.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase) ?? false)
        || library.Id.Contains(_librarySearch, StringComparison.OrdinalIgnoreCase);

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthStateTask.GetUserAsync();
        _isAdmin = TrialAccessService.IsAdmin(_user);

        BreadcrumbState.Set(
            new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"),
            new BreadcrumbItem(Localizer["App.CriteriaManager.Breadcrumb"]));

        if (!_isAdmin)
        {
            return;
        }

        await LoadLibrariesAsync();
    }

    private async Task LoadLibrariesAsync()
    {
        try
        {
            _libraries = [.. await CriteriaService.SearchLibrariesAsync()];
        }
        catch (Exception ex)
        {
            _libraryLoadErrorMessage = ex.Message;
        }
        finally
        {
            _librariesLoading = false;
        }
    }

    private async Task OpenResearchStudyPickerAsync()
    {
        var result = await DialogService.OpenAsync<ResearchStudyPickerDialog>(
            new DialogOpenOptions
            {
                Title = Localizer["App.CriteriaManager.StudyPickerDialogTitle"],
                Description = Localizer["App.CriteriaManager.StudyPickerDialogDescription"],
                Size = DialogSize.Large,
            }
        );

        if (!result.Cancelled && result.GetData<ResearchStudySummaryDto>() is { } study)
        {
            _studyDraft = new ResearchStudyDraft
            {
                ExistingStudyId = study.Id,
                Title = study.Title ?? study.Id,
                Acronym = study.Acronym ?? string.Empty,
                Description = study.Description ?? string.Empty,
            };
            await LoadStudyCriteriaAsync(study.Id);
        }
    }

    /// <summary>
    /// Replaces any previously picked study's criteria with this study's own, ahead of criteria
    /// already drafted on this page. If they can't be loaded, the study is unpicked again rather
    /// than left submittable without them.
    /// </summary>
    private async Task LoadStudyCriteriaAsync(string studyId)
    {
        RemoveStudyCriteria();
        _studyCriteriaLoading = true;
        try
        {
            var criteria = await CriteriaService.GetStudyCriteriaAsync(studyId);
            _studyCriteria.AddRange(criteria);
            _criteria.InsertRange(0, criteria);
        }
        catch (Exception ex)
        {
            _studyDraft = new ResearchStudyDraft();
            Toast.Error(ex.Message, Localizer["App.CriteriaManager.StudyCriteriaLoadErrorTitle"]);
        }
        finally
        {
            _studyCriteriaLoading = false;
        }
    }

    private void ClearExistingStudy()
    {
        _studyDraft = new ResearchStudyDraft();
        RemoveStudyCriteria();
    }

    private void RemoveStudyCriteria()
    {
        _criteria.RemoveAll(_studyCriteria.Contains);
        _studyCriteria.Clear();
    }

    private async Task SubmitAsync()
    {
        _submitting = true;
        try
        {
            await CriteriaService.SubmitAsync(_studyDraft, _criteria);
            Toast.Success(Localizer["App.CriteriaManager.SubmitSuccessMessage"], Localizer["App.Common.Saved"]);
        }
        catch (Exception ex)
        {
            Toast.Error(ex.Message, Localizer["App.CriteriaManager.SubmitErrorTitle"]);
        }
        finally
        {
            _submitting = false;
        }
    }

    private void AddCriterion() => _criteria.Add(new CriterionDraft());

    private async Task OpenLibraryPickerAsync()
    {
        var result = await DialogService.OpenAsync<LibraryCriterionPickerDialog>(
            new Dictionary<string, object?> { ["Libraries"] = _libraries },
            new DialogOpenOptions
            {
                Title = Localizer["App.CriteriaManager.LibraryPickerDialogTitle"],
                Description = Localizer["App.CriteriaManager.LibraryPickerDialogDescription"],
                Size = DialogSize.Large,
            }
        );

        if (!result.Cancelled && result.GetData<LibrarySummaryDto>() is { } library)
        {
            AddCriterionFromLibrary(library);
        }
    }

    private void AddCriterionFromLibrary(LibrarySummaryDto library) =>
        _criteria.Add(
            new CriterionDraft
            {
                DisplayText = library.Title ?? library.Name ?? library.Id,
                ExistingLibraryReference = $"Library/{library.Id}",
                Sql = library.Sql ?? string.Empty,
            }
        );

    private void RemoveCriterion(CriterionDraft criterion) => _criteria.Remove(criterion);

    private void SetCriterionExclude(CriterionDraft criterion, bool exclude) => criterion.Exclude = exclude;

    /// <summary>Moves a criterion up/down within the single, unified criteria order.</summary>
    private void MoveCriterion(CriterionDraft criterion, int direction)
    {
        var index = _criteria.IndexOf(criterion);
        var targetIndex = index + direction;
        if (targetIndex < 0 || targetIndex >= _criteria.Count)
        {
            return;
        }

        (_criteria[index], _criteria[targetIndex]) = (_criteria[targetIndex], _criteria[index]);
    }
}
