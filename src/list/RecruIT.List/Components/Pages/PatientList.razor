@page "/trials/{ListId}/patients"
@attribute [Authorize]
@inject ScreeningListService ScreeningListService
@inject ErrorReporter Errors
@inject EligibilityFunnelService FunnelService
@inject PatientRecordService PatientRecordService
@inject TrialAccessService AccessService
@inject BreadcrumbState BreadcrumbState
@inject NotificationSubscriptionService NotificationSubscriptionService
@inject NotificationInboxState NotificationInboxState
@inject NavigationManager Navigation
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@(_summary?.StudyAcronym ?? Localizer["App.Nav.Patients"])</PageTitle>

@if (_loading)
{
    <BbSkeleton Class="bb:mb-4 bb:h-8 bb:w-64" />
    <BbSkeleton Class="bb:w-full" />
}
else if (_errorMessage is not null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>@Localizer["App.PatientList.LoadErrorTitle"]</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
else if (_summary is not null)
{
    <div class="bb:flex bb:flex-wrap bb:items-start bb:justify-between bb:gap-4">
        <div>
            @if (!string.IsNullOrEmpty(_summary.StudyTitle))
            {
                <h2 class="bb:text-lg bb:font-medium">@_summary.StudyTitle</h2>
            }
        </div>
        <div class="bb:flex bb:shrink-0 bb:items-center bb:gap-2">
            @if (_summary.Criteria.Count > 0 || FunnelChartData is { Count: > 0 })
            {
                @* Labelled rather than icon-only like its neighbours: the criteria are the trial's most important
                   reference, and "list-checks" alone doesn't say so. Named like the column it explains - the sheet
                   it opens carries the full "Eligibility criteria" title. *@
                <BbButton Variant="ButtonVariant.Outline" Class="bb:shrink-0" OnClick="@(() => _criteriaOpen = true)">
                    <Icon><LucideIcon Name="list-checks" Size="16" /></Icon>
                    <ChildContent>@Localizer["App.PatientList.ColumnCriteria"]</ChildContent>
                </BbButton>
                <BbSheet @bind-Open="_criteriaOpen">
                    @* Focus the panel rather than the first criterion, whose SQL popover would otherwise get the focus ring.
                       Width set inline: the precompiled bb: bundle has no utility wide enough to beat the sheet's sm:max-w-sm. *@
                    <BbSheetContent Class="bb:overflow-y-auto" InitialFocus="FocusTrapInitialFocus.Container"
                                    style="width: min(36rem, 100vw); max-width: 100vw;">
                        <BbSheetHeader>
                            <BbSheetTitle>@Localizer["App.PatientList.CriteriaButton"]</BbSheetTitle>
                            @if (!string.IsNullOrEmpty(_summary.StudyTitle))
                            {
                                <BbSheetDescription>@_summary.StudyTitle</BbSheetDescription>
                            }
                        </BbSheetHeader>
                        <div class="bb:flex bb:flex-col bb:gap-6 bb:px-4 bb:pb-4">
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.InclusionCriteria"]</span>
                                @if (InclusionCriteria.Count == 0)
                                {
                                    <p class="bb:mt-1.5 bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientList.NoCriteria"]</p>
                                }
                                else
                                {
                                    <ul class="bb:mt-1.5 bb:space-y-1 bb:text-sm">
                                        @foreach (var criterion in InclusionCriteria)
                                        {
                                            <CriterionListItem Criterion="criterion" />
                                        }
                                    </ul>
                                }
                            </div>
                            <div>
                                <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.ExclusionCriteria"]</span>
                                @if (ExclusionCriteria.Count == 0)
                                {
                                    <p class="bb:mt-1.5 bb:text-sm bb:text-muted-foreground">@Localizer["App.PatientList.NoCriteria"]</p>
                                }
                                else
                                {
                                    <ul class="bb:mt-1.5 bb:space-y-1 bb:text-sm">
                                        @foreach (var criterion in ExclusionCriteria)
                                        {
                                            <CriterionListItem Criterion="criterion" />
                                        }
                                    </ul>
                                }
                            </div>
                            @if (FunnelChartData is { Count: > 0 })
                            {
                                <div>
                                    <span class="bb:text-xs bb:font-medium bb:uppercase bb:tracking-wide bb:text-muted-foreground">@Localizer["App.PatientList.FunnelSectionTitle"]</span>
                                    <BbFunnelChart Data="@FunnelChartData" Height="280px" Class="bb:mt-1.5">
                                        <BbChartTooltip />
                                        <BbFunnel DataKey="value" NameKey="stage" Sort="FunnelSort.None" LabelFormatter="{b}: {c}" MinSize="15%" />
                                    </BbFunnelChart>
                                </div>
                            }
                        </div>
                    </BbSheetContent>
                </BbSheet>
            }
            <NotificationSubscribeButton TrialIdentifier="_summary.TrialIdentifier" />
            @if (_canManageAccess)
            {
                <BbTooltip>
                    <BbTooltipTrigger AsChild="true">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Icon" Class="bb:shrink-0"
                                  AriaLabel="@Localizer["App.PatientList.ManageAccessLink"]" OnClick="@(() => Navigation.NavigateTo($"/trials/{ListId}/access"))">
                            <LucideIcon Name="lock" Size="16" />
                        </BbButton>
                    </BbTooltipTrigger>
                    <BbTooltipContent>@Localizer["App.PatientList.ManageAccessLink"]</BbTooltipContent>
                </BbTooltip>
            }
        </div>
    </div>

    @if (_patients.Count == 0)
    {
        <BbEmpty Title="@Localizer["App.PatientList.EmptyTitle"]" Description="@Localizer["App.PatientList.EmptyDescription"]" />
    }
    else
    {
        <div class="bb:mb-4 bb:flex bb:flex-wrap bb:items-center bb:justify-between bb:gap-3">
            @* Who needs a look comes first: "New" right after "All", then the statuses in pipeline order, each
               with its count - only the ones someone on this list is in, so the row stays short. *@
            <BbToggleGroup TValue="string" Type="ToggleGroupType.Single" Value="@_filter" ValueChanged="SetFilter"
                           Required="true" Variant="ToggleVariant.Outline" Size="ToggleSize.Small" Scrollable="true"
                           Class="bb:min-w-0" aria-label="@Localizer["App.PatientList.FilterLabel"]">
                <BbToggleGroupItem TValue="string" Value="@FilterAll">
                    @Localizer["App.PatientList.FilterAll"] <span class="status-filter-count">@_patients.Count</span>
                </BbToggleGroupItem>
                <BbToggleGroupItem TValue="string" Value="@FilterNew">
                    @Localizer["App.PatientList.New"] <span class="status-filter-count">@_patients.Count(IsNew)</span>
                </BbToggleGroupItem>
                @foreach (var (status, count) in StatusCounts)
                {
                    <BbToggleGroupItem TValue="string" Value="@status" @key="status">
                        @Localizer[StatusDisplay.GetKey(status)] <span class="status-filter-count">@count</span>
                    </BbToggleGroupItem>
                }
            </BbToggleGroup>
            <BbInput @bind-Value="_search" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
                     Placeholder="@Localizer["App.PatientList.SearchPlaceholder"]" Class="bb:w-full bb:max-w-sm" />
        </div>
        <BbDataTable TData="PatientListEntryDto" Data="FilteredPatients" ShowToolbar="false" ShowPagination="true"
                     PageSizes="new[] { 10, 25, 50, 100 }" InitialPageSize="25" IsLoading="false">
            <EmptyTemplate>
                <BbEmpty Title="@Localizer["App.PatientList.NoMatchesTitle"]" Description="@Localizer["App.PatientList.NoMatchesDescription"]">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="ShowAll">@Localizer["App.PatientList.ShowAll"]</BbButton>
                </BbEmpty>
            </EmptyTemplate>
            <Columns>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="DateTimeOffset?" Header="@Localizer["App.PatientList.ColumnRecommended"]" Property="p => p.RecommendedDate" Sortable="true">
                    <CellTemplate Context="p">
                        <div class="bb:flex bb:items-center bb:gap-2 bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            @* The slot is always there so the dates stay aligned whether or not a row has a dot. *@
                            @if (IsNew(p))
                            {
                                <span class="new-suggestion-dot bb:size-2 bb:shrink-0 bb:rounded-full bb:bg-primary" title="@Localizer["App.PatientList.NewIndicator"]"></span>
                                <span class="bb:sr-only">@Localizer["App.PatientList.NewIndicator"]</span>
                            }
                            else
                            {
                                <span class="bb:size-2 bb:shrink-0" aria-hidden="true"></span>
                            }
                            @(p.RecommendedDate?.LocalDateTime.ToString("d") ?? "-")
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnName"]" Property="p => p.DisplayName" Sortable="true" MinWidth="12rem">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            <span class="bb:font-medium bb:hover:underline">@p.DisplayName</span>
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                @* Right after the name: why the patient is on the list. Sorting by it gathers the patients whose
                   eligibility is least settled (see PatientListEntryDto.OpenCriteriaCount). Hidden for trials whose
                   criteria aren't split into separate Libraries, which have nothing per criterion to show. *@
                <BbDataTableColumn TData="PatientListEntryDto" TValue="int?" Header="@Localizer["App.PatientList.ColumnCriteria"]"
                                   Property="p => p.OpenCriteriaCount" Sortable="true" Visible="_summary.Criteria.Count > 0">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            @if (p.CriteriaStatusesLoaded)
                            {
                                <CriteriaSummary Criteria="p.CriteriaStatuses" />
                            }
                            else
                            {
                                <BbSkeleton Class="bb:h-4 bb:w-16" />
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="int?" Header="@Localizer["App.PatientList.ColumnDemographics"]" Width="140px">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            @(p.Age is not null ? p.Age.ToString() : Localizer["App.Common.AgeUnknown"].Value)
                            <span class="bb:text-muted-foreground">&middot;</span>
                            @(p.Gender is not null ? Localizer[GenderDisplay.GetKey(p.Gender)].Value : Localizer["App.Common.Unknown"].Value)
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnStatus"]">
                    <CellTemplate Context="p">
                        <div class="bb:flex bb:flex-wrap bb:items-center bb:gap-2 bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            <StatusBadge Status="@p.Status" />
                            @if (p.SystemDeterminedIneligible)
                            {
                                <BbBadge Variant="BadgeVariant.Outline">@Localizer["App.PatientList.SystemIneligibleBadge"]</BbBadge>
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="string" Header="@Localizer["App.PatientList.ColumnLocation"]">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            @if (p.LastKnownLocationLoaded)
                            {
                                @(p.LastKnownLocation ?? Localizer["App.Common.Unknown"].Value)
                            }
                            else
                            {
                                <BbSkeleton Class="bb:h-4 bb:w-24" />
                            }
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
                <BbDataTableColumn TData="PatientListEntryDto" TValue="DateTimeOffset?" Header="@Localizer["App.PatientList.ColumnUpdated"]" Property="p => p.LastUpdated" Sortable="true">
                    <CellTemplate Context="p">
                        <div class="bb:block bb:cursor-pointer bb:p-4 @RowMarker(p)" @onclick="() => OpenPatient(p)">
                            @(p.LastUpdated?.LocalDateTime.ToString("g") ?? "-")
                        </div>
                    </CellTemplate>
                </BbDataTableColumn>
            </Columns>
        </BbDataTable>
    }

    <PatientDialog Patient="_selectedPatient" PatientChanged="p => _selectedPatient = p"
                   Acronym="@_summary.StudyAcronym" StudyTitle="@_summary.StudyTitle"
                   TrialIdentifier="_summary.TrialIdentifier" TrialCriteria="_summary.Criteria" CanEdit="_canEdit" />
}

@code {
    [Parameter]
    public string ListId { get; set; } = string.Empty;

    /// <summary>
    /// A ResearchSubject id to open and highlight once the list has loaded - the deep link the
    /// notifications page uses for "this patient was newly recommended".
    /// </summary>
    [SupplyParameterFromQuery(Name = "subject")]
    public string? Subject { get; set; }

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private TrialSummaryDto? _summary;
    private List<PatientListEntryDto> _patients = [];
    private string _search = string.Empty;

    private const string FilterAll = "all";
    private const string FilterNew = "new";

    /// <summary>FilterAll, FilterNew or a ResearchSubject.status.</summary>
    private string _filter = FilterAll;

    /// <summary>
    /// Patients opened while the current filter was on - kept in view even once they no longer match
    /// (opening a new patient marks them seen; a status change moves them to another status), so the
    /// row doesn't vanish from under the sheet. Cleared whenever the filter changes.
    /// </summary>
    private readonly HashSet<PatientListEntryDto> _keptInView = [];

    /// <summary>ResearchSubject.status in pipeline order, as the patient dialog offers them.</summary>
    private static readonly string[] StatusOrder = ["candidate", "screening", "eligible", "ineligible", "on-study", "withdrawn"];
    private bool _criteriaOpen;
    private List<FunnelStepDto>? _funnelSteps;
    private bool _loading = true;
    private bool _canEdit;
    private bool _canManageAccess;
    private string? _errorMessage;
    private ClaimsPrincipal _user = new();

    private PatientListEntryDto? _selectedPatient;

    /// <summary>The ?subject= deep link's patient, if it's on this list - stays highlighted after its dialog is closed.</summary>
    private PatientListEntryDto? _highlightedPatient;

    /// <summary>
    /// The caller's unread in-app notifications for this trial, by ResearchSubject id (see
    /// NotificationSubscriptionService.GetUnreadInAppByResearchSubjectAsync) - a row is shown as
    /// new while its patient is in here, and opening it marks those notifications read.
    /// </summary>
    private Dictionary<string, IReadOnlyList<Guid>> _unreadBySubject = [];

    /// <summary>
    /// Replaces the data table's own toolbar search, which comes with an unwanted column-visibility
    /// button - matches what the table shows: display name, MRN, patient id and last known location.
    /// </summary>
    private List<PatientListEntryDto> FilteredPatients =>
        [.. PinnedPatients.Where(p => MatchesFilter(p) && MatchesSearch(p))];

    private bool MatchesFilter(PatientListEntryDto patient) =>
        _keptInView.Contains(patient) || _filter switch
        {
            FilterAll => true,
            FilterNew => IsNew(patient),
            _ => patient.Status == _filter,
        };

    private bool MatchesSearch(PatientListEntryDto p) =>
        string.IsNullOrWhiteSpace(_search)
        || Matches(p.DisplayName) || Matches(p.MedicalRecordNumber) || Matches(p.PatientId) || Matches(p.LastKnownLocation);

    /// <summary>
    /// How many patients are in each status, in pipeline order (any status outside it last). The
    /// selected one stays even at zero, so the filter in use never disappears from the row.
    /// </summary>
    private IEnumerable<(string Status, int Count)> StatusCounts =>
        _patients
            .Select(p => p.Status)
            .Append(_filter is FilterAll or FilterNew ? null : _filter)
            .OfType<string>()
            .Distinct()
            .OrderBy(s => Array.IndexOf(StatusOrder, s) is var i and >= 0 ? i : StatusOrder.Length)
            .Select(s => (s, _patients.Count(p => p.Status == s)));

    private void SetFilter(string? filter)
    {
        _filter = filter ?? FilterAll;
        _keptInView.Clear();
    }

    private void ShowAll()
    {
        _search = string.Empty;
        SetFilter(FilterAll);
    }

    /// <summary>
    /// The highlighted patient first, rest in their usual order (OrderBy is stable) - the data
    /// table pages client-side and offers no way to jump to a row's page, so this is what keeps
    /// the deep-linked patient on the first page (until the user sorts by a column themselves).
    /// </summary>
    private List<PatientListEntryDto> PinnedPatients => _highlightedPatient is null
        ? _patients
        : [.. _patients.OrderBy(p => !ReferenceEquals(p, _highlightedPatient))];

    /// <summary>
    /// The data table has no per-row class, so each cell of the highlighted row carries this
    /// marker instead and app.css tints the whole row via tr:has(...).
    /// </summary>
    private string RowMarker(PatientListEntryDto patient) =>
        ReferenceEquals(patient, _highlightedPatient) ? "patient-row-highlight" : string.Empty;

    private bool Matches(string? value) => value?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false;

    private bool IsNew(PatientListEntryDto patient) => _unreadBySubject.ContainsKey(patient.ResearchSubjectId);

    private List<CriterionDefinitionDto> InclusionCriteria => _summary?.Criteria.Where(c => !c.Exclude).ToList() ?? [];

    private List<CriterionDefinitionDto> ExclusionCriteria => _summary?.Criteria.Where(c => c.Exclude).ToList() ?? [];

    private List<FunnelChartPoint>? FunnelChartData =>
        _funnelSteps
            ?.Select(s => new FunnelChartPoint(
                s.IsTotalPopulation
                    ? Localizer["App.PatientList.FunnelTotalPopulationLabel"].Value
                    : CriterionName(s.LibraryId) ?? s.Label ?? string.Empty,
                s.Count
            ))
            .ToList();

    /// <summary>
    /// A funnel step's criterion under the name the criteria list above it uses - the funnel's own
    /// label is a snapshot from when it was computed, which drifts once a Library is renamed.
    /// </summary>
    private string? CriterionName(string? libraryId) =>
        libraryId is null ? null : _summary?.Criteria.FirstOrDefault(c => c.LibraryId == libraryId)?.DisplayText;

    private record FunnelChartPoint(string Stage, int Value);

    protected override async Task OnInitializedAsync()
    {
        _user = await AuthStateTask.GetUserAsync();
        await LoadAsync();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            var (summary, patients) = await ScreeningListService.GetListWithPatientsAsync(ListId, _user);
            _summary = summary;
            _patients = [.. patients];
            _highlightedPatient = Subject is null ? null : _patients.FirstOrDefault(p => p.ResearchSubjectId == Subject);
            _selectedPatient ??= _highlightedPatient;
            var permission = await AccessService.GetPermissionAsync(_user, summary.TrialIdentifier);
            _canEdit = TrialAccessService.MeetsCoordinatorThreshold(permission);
            _canManageAccess = TrialAccessService.MeetsTrialAdminThreshold(permission);
            BreadcrumbState.Set(new BreadcrumbItem(Localizer["App.Common.AllTrialsBreadcrumb"], "/"), new BreadcrumbItem(summary.StudyAcronym));
            _funnelSteps = await TryLoadFunnelAsync(summary.StudyId);
            _unreadBySubject = await TryLoadUnreadAsync(summary.TrialIdentifier);
            if (_highlightedPatient is not null)
            {
                // Opened straight away by the deep link, so it counts as seen just like a click -
                // the notifications page already marked the item it came from read, but an older
                // notification for the same patient could still be unread.
                await MarkSeenAsync(_highlightedPatient);
            }

            // Fire-and-forget rather than gating on OnAfterRenderAsync(firstRender): when
            // GetListWithPatientsAsync resolves fast enough (e.g. a warm connection from in-app
            // navigation), Blazor can fold the whole initial load into a single render, so the
            // "first" OnAfterRenderAsync would already be past firstRender=true and this would
            // never fire on a cold/direct page load where the fetch takes longer.
            if (_patients.Count > 0)
            {
                _ = LoadLocationsInBackgroundAsync();
                if (summary.Criteria.Count > 0)
                {
                    _ = LoadCriteriaStatusesInBackgroundAsync(summary.TrialIdentifier);
                }
            }
        }
        catch (Exception ex)
        {
            _errorMessage = Errors.Report(ex, "load the trial's patient list", Localizer["App.PatientList.LoadErrorFallback"]);
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>
    /// The funnel is an optional, best-effort enhancement - most studies won't have one yet (the
    /// query-sql-on-fhir feature flag producing it defaults to off), and a failure fetching it
    /// shouldn't block the rest of the page from loading.
    /// </summary>
    private async Task<List<FunnelStepDto>?> TryLoadFunnelAsync(string studyId)
    {
        try
        {
            var steps = await FunnelService.GetFunnelAsync(studyId);
            return steps?.ToList();
        }
        catch (Exception ex)
        {
            Errors.Swallowed(ex, "load the attrition funnel");
            return null;
        }
    }

    /// <summary>Best-effort like the funnel - without it the list simply shows no rows as new.</summary>
    private async Task<Dictionary<string, IReadOnlyList<Guid>>> TryLoadUnreadAsync(TrialIdentifier trialIdentifier)
    {
        try
        {
            var unread = await NotificationSubscriptionService.GetUnreadInAppByResearchSubjectAsync(_user, trialIdentifier);
            return new Dictionary<string, IReadOnlyList<Guid>>(unread);
        }
        catch (Exception ex)
        {
            Errors.Swallowed(ex, "load the unread notifications");
            return [];
        }
    }

    /// <summary>
    /// Drops the row's dot right away, then marks its notifications read and refreshes the
    /// sidebar's unread badge. Best-effort: if saving fails the item simply stays unread on the
    /// notifications page, which isn't worth interrupting opening the patient over.
    /// </summary>
    private async Task MarkSeenAsync(PatientListEntryDto patient)
    {
        if (!_unreadBySubject.Remove(patient.ResearchSubjectId, out var deliveryIds))
        {
            return;
        }

        try
        {
            await NotificationSubscriptionService.MarkReadAsync(deliveryIds, _user);
            await NotificationInboxState.RefreshAsync(_user);
        }
        catch (Exception ex)
        {
            // See summary - left unread, nothing else to undo.
            Errors.Swallowed(ex, "mark the patient's notifications read");
        }
    }

    private async Task LoadLocationsInBackgroundAsync()
    {
        using var throttle = new SemaphoreSlim(8);
        var tasks = _patients.Select(async patient =>
        {
            await throttle.WaitAsync();
            try
            {
                var location = await PatientRecordService.GetLatestLocationAsync(patient.PatientId);
                patient.LastKnownLocation = location?.LocationName;
            }
            catch (Exception ex)
            {
                Errors.Swallowed(ex, "load the patient's last known location");
                patient.LastKnownLocation = null;
            }
            finally
            {
                patient.LastKnownLocationLoaded = true;
                throttle.Release();
                await InvokeAsync(StateHasChanged);
            }
        });

        await Task.WhenAll(tasks);
    }

    /// <summary>
    /// Every row's criteria in one search rather than one per patient - like the locations, after the
    /// list itself so it never holds the page up. A failure leaves every row saying so ("Not
    /// available") rather than looking like nothing was assessed.
    /// </summary>
    private async Task LoadCriteriaStatusesInBackgroundAsync(TrialIdentifier trialIdentifier)
    {
        IReadOnlyDictionary<string, IReadOnlyList<CriterionStatusDto>>? byPatient;
        try
        {
            byPatient = await PatientRecordService.GetEligibilityCriteriaStatusByPatientAsync(trialIdentifier);
        }
        catch (System.Net.Http.HttpRequestException ex)
        {
            Errors.Swallowed(ex, "load the patients' eligibility criteria");
            byPatient = null;
        }
        catch (TaskCanceledException ex)
        {
            Errors.Swallowed(ex, "load the patients' eligibility criteria");
            byPatient = null;
        }

        foreach (var patient in _patients)
        {
            patient.CriteriaStatuses = byPatient is null ? null : byPatient.GetValueOrDefault(patient.PatientId) ?? [];
            patient.CriteriaStatusesLoaded = true;
        }

        await InvokeAsync(StateHasChanged);
    }

    private Task OpenPatient(PatientListEntryDto patient)
    {
        _selectedPatient = patient;
        _keptInView.Add(patient);
        return MarkSeenAsync(patient);
    }
}
