@page "/patients"
@attribute [Authorize]
@inject ScreeningListService ScreeningListService
@inject TrialAccessService AccessService
@inject BreadcrumbState BreadcrumbState
@inject IStringLocalizer<SharedResources> Localizer

<PageTitle>@Localizer["App.Nav.Patients"]</PageTitle>

@if (_loading)
{
    <BbSkeleton Class="bb:mb-4 bb:h-8 bb:w-64" />
    <BbSkeleton Class="bb:w-full" />
}
else if (_errorMessage is not null)
{
    <BbAlert Variant="AlertVariant.Danger">
        <BbAlertTitle>@Localizer["App.PatientsPage.LoadErrorTitle"]</BbAlertTitle>
        <BbAlertDescription>@_errorMessage</BbAlertDescription>
    </BbAlert>
}
else if (_patients.Count == 0)
{
    <BbEmpty Title="@Localizer["App.PatientsPage.EmptyTitle"]" Description="@Localizer["App.PatientsPage.EmptyDescription"]" />
}
else
{
    <BbInput @bind-Value="_search" UpdateTiming="UpdateTiming.Debounced" DebounceInterval="300"
             Placeholder="@Localizer["App.PatientList.SearchPlaceholder"]" Class="bb:mb-4 bb:max-w-sm" />
    <BbDataTable TData="PatientOverviewDto" Data="FilteredPatients" ShowToolbar="false" ShowPagination="true"
                 PageSizes="new[] { 10, 25, 50, 100 }" InitialPageSize="25" IsLoading="false">
        <Columns>
            <BbDataTableColumn TData="PatientOverviewDto" TValue="string" Header="@Localizer["App.PatientList.ColumnName"]" Property="p => p.DisplayName" Sortable="true">
                <CellTemplate Context="p">
                    <span class="bb:font-medium">@p.DisplayName</span>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="PatientOverviewDto" TValue="int?" Header="@Localizer["App.PatientList.ColumnDemographics"]" Width="140px">
                <CellTemplate Context="p">
                    @(p.Age is not null ? p.Age.ToString() : Localizer["App.Common.AgeUnknown"].Value)
                    <span class="bb:text-muted-foreground">&middot;</span>
                    @(p.Gender is not null ? Localizer[GenderDisplay.GetKey(p.Gender)].Value : Localizer["App.Common.Unknown"].Value)
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="PatientOverviewDto" TValue="int" Header="@Localizer["App.PatientsPage.ColumnStudies"]">
                <CellTemplate Context="p">
                    <div class="bb:flex bb:flex-wrap bb:gap-1.5">
                        @foreach (var membership in p.Trials)
                        {
                            <div class="bb:flex bb:cursor-pointer bb:items-center bb:gap-1 bb:rounded-md bb:p-0.5 bb:hover:bg-accent"
                                 @onclick="() => OpenPatient(membership)">
                                <span class="bb:text-sm bb:font-medium">@membership.StudyAcronym</span>
                                <StatusBadge Status="@membership.Status" />
                            </div>
                        }
                    </div>
                </CellTemplate>
            </BbDataTableColumn>
            <BbDataTableColumn TData="PatientOverviewDto" TValue="DateTimeOffset?" Header="@Localizer["App.PatientList.ColumnUpdated"]"
                               Property="p => p.Trials.Max(t => t.LastUpdated)" Sortable="true">
                <CellTemplate Context="p">
                    @(p.Trials.Max(t => t.LastUpdated)?.LocalDateTime.ToString("g") ?? "-")
                </CellTemplate>
            </BbDataTableColumn>
        </Columns>
    </BbDataTable>

    <PatientDialog Patient="_selectedPatient" PatientChanged="p => _selectedPatient = p"
                   Acronym="@(_selectedPatient?.StudyAcronym ?? string.Empty)" StudyTitle="@_selectedPatient?.StudyTitle"
                   TrialIdentifier="_selectedPatient?.TrialIdentifier" CanEdit="_canEditSelected" />
}

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private List<PatientOverviewDto> _patients = [];
    private string _search = string.Empty;

    /// <summary>
    /// Replaces the data table's own toolbar search, which comes with an unwanted column-visibility
    /// button - matches what the table shows: name, patient id and the acronyms of their studies.
    /// </summary>
    private List<PatientOverviewDto> FilteredPatients => string.IsNullOrWhiteSpace(_search)
        ? _patients
        : [.. _patients.Where(p =>
            Matches(p.DisplayName) || Matches(p.PatientId) || p.Trials.Any(t => Matches(t.StudyAcronym)))];

    private bool Matches(string? value) => value?.Contains(_search.Trim(), StringComparison.OrdinalIgnoreCase) ?? false;
    private bool _loading = true;
    private string? _errorMessage;
    private ClaimsPrincipal _user = new();

    private PatientListEntryDto? _selectedPatient;
    private bool _canEditSelected;

    protected override async Task OnInitializedAsync()
    {
        BreadcrumbState.Set(new BreadcrumbItem(Localizer["App.Nav.Patients"]));

        try
        {
            _user = await AuthStateTask.GetUserAsync();
            _patients = [.. await ScreeningListService.GetPatientsAcrossTrialsAsync(_user)];
        }
        catch (FhirAccessException ex)
        {
            _errorMessage = ex.Message;
        }
        catch (Exception)
        {
            _errorMessage = Localizer["App.PatientsPage.LoadErrorFallback"];
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task OpenPatient(PatientListEntryDto membership)
    {
        _selectedPatient = membership;
        _canEditSelected = membership.TrialIdentifier is not null &&
            TrialAccessService.MeetsCoordinatorThreshold(
                await AccessService.GetPermissionAsync(_user, membership.TrialIdentifier));
    }
}
