<mjml lang="de">
  <mj-head>
    <mj-title>Neue Rekrutierungsvorschläge | recruIT</mj-title>
    <mj-preview>{% if NumNewSubjects == 1 %}1 neuer Rekrutierungsvorschlag{% else %}{{ NumNewSubjects }} neue Rekrutierungsvorschläge{% endif %} für {{ StudyAcronym }}</mj-preview>
    <mj-attributes>
      <mj-all font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Helvetica, Arial, sans-serif" />
      <mj-section padding="0" />
      <mj-text color="#1a2530" font-size="15px" line-height="1.6" padding="0 36px" />
    </mj-attributes>
    <mj-style>
      .muted-link a { color: #1a6289 !important; word-break: break-all; }
    </mj-style>
  </mj-head>

  <mj-body background-color="#f7f7f8" width="560px">

    <mj-section padding="36px 0 20px">
      <mj-column>
        <mj-text align="center" font-size="22px" font-weight="700" letter-spacing="-0.02em">
          recru<span style="color: #1a6289;">IT</span>
        </mj-text>
      </mj-column>
    </mj-section>

    <mj-wrapper background-color="#ffffff" border="1px solid #dbe0e6" border-radius="12px" padding="0">

      <mj-section background-color="#1a6289" border-radius="12px 12px 0 0" padding="0">
        <mj-column>
          <mj-spacer height="5px" />
        </mj-column>
      </mj-section>

      <mj-section padding="36px 0 0">
        <mj-column>
          <mj-text align="center" font-size="12px" font-weight="600" letter-spacing="0.08em" color="#1a6289" text-transform="uppercase">
            Neue Rekrutierungsvorschläge
          </mj-text>

          <mj-text align="center" font-size="60px" font-weight="700" line-height="1.1" letter-spacing="-0.03em" padding="14px 36px 0">
            {{ NumNewSubjects }}
          </mj-text>

          <mj-text align="center" color="#5a6573" padding="2px 36px 0">
            {% if NumNewSubjects == 1 %}möglicher neuer Vorschlag{% else %}mögliche neue Vorschläge{% endif %} für
          </mj-text>

          <mj-text align="center" line-height="2.2" padding="10px 36px 0">
            <span style="display: inline-block; background-color: #d9e6ee; color: #0f4866; border-radius: 999px; padding: 2px 14px; margin: 0 2px; font-size: 14px; font-weight: 600; line-height: 1.8;">{{ StudyAcronym }}</span>
          </mj-text>
        </mj-column>
      </mj-section>

      <mj-section padding="28px 0 28px">
        <mj-column>
          <mj-text>
            Hallo,
          </mj-text>
          <mj-text padding="8px 36px 0">
            recruIT hat neue mögliche Teilnehmende für Ihre abonnierte Studie gefunden. Bitte prüfen Sie die Vorschläge in der Screeningliste.
          </mj-text>

          <mj-button href="{{ ScreeningListLink }}" background-color="#1a6289" color="#ffffff" font-size="15px" font-weight="600" border-radius="8px" inner-padding="14px 32px" padding="28px 36px 0">
            Screeningliste öffnen &rarr;
          </mj-button>

          <mj-text align="center" font-size="12px" line-height="1.5" color="#5a6573" padding="16px 36px 0" css-class="muted-link">
            Falls die Schaltfläche nicht funktioniert, öffnen Sie diesen Link:<br />
            <a href="{{ ScreeningListLink }}" style="color: #1a6289;">{{ ScreeningListLink }}</a>
          </mj-text>
        </mj-column>
      </mj-section>

    </mj-wrapper>

    <mj-section padding="20px 0 36px">
      <mj-column>
        <mj-text align="center" font-size="12px" line-height="1.6" color="#8a94a1">
          Sie erhalten diese E-Mail, weil Sie in recruIT Benachrichtigungen abonniert haben. Häufigkeit ändern oder abbestellen können Sie jederzeit über das Glocken-Symbol der jeweiligen Studie.
        </mj-text>
      </mj-column>
    </mj-section>

  </mj-body>
</mjml>
