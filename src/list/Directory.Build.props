<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>
    <!-- Runtime-managed async instead of compiler-generated state machines: real call chains in live
         stack traces (debugger, profilers) and less per-await overhead. -->
    <Features>$(Features);runtime-async=on</Features>
    <!-- x-release-please-start-version -->
    <Version>11.2.0</Version>
    <!-- x-release-please-end -->
    <Company>miracum.org</Company>
    <Description>Patient recruitment on FHIR.</Description>
    <Copyright>© miracum.org. All rights reserved.</Copyright>
    <NeutralLanguage>en-US</NeutralLanguage>
    <Authors>miracum.org</Authors>
  </PropertyGroup>
</Project>
