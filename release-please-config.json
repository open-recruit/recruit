{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "bump-minor-pre-major": true,
  "bump-patch-for-minor-pre-major": true,
  "include-v-in-tag": true,
  "separate-pull-requests": true,
  "extra-label": "release-please",
  "release-type": "simple",
  "packages": {
    ".": {
      "extra-files": [
        {
          "type": "generic",
          "path": "charts/recruit/Chart.yaml"
        },
        "charts/recruit/values.yaml",
        "src/list/Dockerfile",
        "src/list/Directory.Build.props",
        "src/buildSrc/src/main/groovy/org.miracum.recruit.java-common-conventions.gradle",
        "src/query-sql-on-fhir/src/main/resources/application.yml",
        "compose/compose.yaml",
        "docs/configuration/security.md",
        "docs/getting-started/installation.md",
        "docs/_snippets/k8s/query-argo-workflow.yaml",
        {
          "type": "generic",
          "path": "fhir/ig/sushi-config.yaml"
        },
        {
          "type": "json",
          "path": "fhir/package.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "fhir/ig/fsh-generated/resources/ImplementationGuide-dev.openrecruit.fhir.json",
          "jsonpath": "$.version"
        }
      ],
      "changelog-sections": [
        {
          "type": "feat",
          "section": "Features"
        },
        {
          "type": "fix",
          "section": "Bug Fixes"
        },
        {
          "type": "perf",
          "section": "Performance Improvements"
        },
        {
          "type": "docs",
          "section": "Documentation",
          "hidden": false
        },
        {
          "type": "chore",
          "scope": "release",
          "section": "Miscellaneous Chores",
          "hidden": true
        },
        {
          "type": "chore",
          "section": "Miscellaneous Chores",
          "hidden": false
        },
        {
          "type": "build",
          "section": "Build",
          "hidden": false
        },
        {
          "type": "ci",
          "section": "CI/CD",
          "hidden": false
        }
      ]
    }
  }
}
