    {
      "resource": {
        "resourceType": "Library",
        "id": "9be54194-a4d9-4835-bf9e-21314e4f046c",
        "meta": {
          "profile": [
            "https://openrecruit.dev/fhir/StructureDefinition/sql-query-library"
          ]
        },
        "type": {
          "coding": [
            {
              "code": "sql-query",
              "system": "https://sql-on-fhir.org/ig/CodeSystem/LibraryTypesCodes"
            }
          ]
        },
        "status": "active",
        "name": "sepsis",
        "identifier": [
          {
            "system": "https://openrecruit.dev/fhir/identifiers/sql-criteria-library-id",
            "value": "sepsis"
          }
        ],
        "content": [
          {
            "contentType": "application/sql;dialect=trino",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    EXISTS (\n        SELECT 1\n        FROM\n            fhir.default.condition AS sepsis,\n            UNNEST(sepsis.code.coding) AS sepsis_coding,\n            fhir.default.condition AS bronchitis,\n            UNNEST(bronchitis.code.coding) AS bronchitis_coding\n        WHERE\n            sepsis.subject.reference = CONCAT('Patient/', patient.id)\n            AND sepsis_coding.system = 'http://snomed.info/sct'\n            AND sepsis_coding.code IN ('91302008')\n            AND bronchitis.subject.reference = sepsis.subject.reference\n            AND bronchitis_coding.system = 'http://snomed.info/sct'\n            AND bronchitis_coding.code IN ('10509002')\n            AND from_iso8601_timestamp(COALESCE(sepsis.onsetdatetime, sepsis.recordeddate))\n                BETWEEN from_iso8601_timestamp(COALESCE(bronchitis.onsetdatetime, bronchitis.recordeddate)) - INTERVAL '3' MONTH\n                    AND from_iso8601_timestamp(COALESCE(bronchitis.onsetdatetime, bronchitis.recordeddate)) + INTERVAL '3' MONTH\n    ) AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          },
          {
            "contentType": "application/sql;dialect=duckdb",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    EXISTS (\n        SELECT 1\n        FROM\n            (\n                SELECT\n                    sepsis.subject.reference AS subject_reference,\n                    CAST(COALESCE(sepsis.onsetdatetime, sepsis.recordeddate) AS TIMESTAMPTZ) AS onset\n                FROM\n                    fhir.default.condition AS sepsis,\n                    UNNEST(sepsis.code.coding) AS u(sepsis_coding)\n                WHERE\n                    sepsis_coding.system = 'http://snomed.info/sct'\n                    AND sepsis_coding.code IN ('91302008')\n            ) AS sepsis\n            JOIN (\n                SELECT\n                    bronchitis.subject.reference AS subject_reference,\n                    CAST(COALESCE(bronchitis.onsetdatetime, bronchitis.recordeddate) AS TIMESTAMPTZ) AS onset\n                FROM\n                    fhir.default.condition AS bronchitis,\n                    UNNEST(bronchitis.code.coding) AS v(bronchitis_coding)\n                WHERE\n                    bronchitis_coding.system = 'http://snomed.info/sct'\n                    AND bronchitis_coding.code IN ('10509002')\n            ) AS bronchitis ON bronchitis.subject_reference = sepsis.subject_reference\n        WHERE\n            sepsis.subject_reference = CONCAT('Patient/', patient.id)\n            AND sepsis.onset\n                BETWEEN bronchitis.onset - INTERVAL 3 MONTH\n                    AND bronchitis.onset + INTERVAL 3 MONTH\n    ) AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": ""
          }
        ],
        "title": "Sepsis within 3 months of bronchitis",
        "description": "Sepsis diagnosis (SNOMED CT code 91302008) with an onset within 3 months before or after a bronchitis diagnosis (SNOMED CT code 10509002), falling back to the recorded date where no onset is documented."
      },
      "request": {
        "method": "PUT",
        "url": "Library/9be54194-a4d9-4835-bf9e-21314e4f046c"
      }
    }
  ]
