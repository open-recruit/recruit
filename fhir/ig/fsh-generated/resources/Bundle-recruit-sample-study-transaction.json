        "meta": {
          "profile": [
            "https://openrecruit.dev/fhir/StructureDefinition/sql-query-library"
          ]
        },
        "type": {
          "coding": [
            {
              "code": "sql-query",
              "system": "https://sql-on-fhir.org/ig/CodeSystem/LibraryTypesCodes"
            }
          ]
        },
        "status": "active",
        "name": "age-over-18",
        "identifier": [
          {
            "system": "https://openrecruit.dev/fhir/identifiers/sql-criteria-library-id",
            "value": "age-over-18"
          }
        ],
        "content": [
          {
            "contentType": "application/sql;dialect=trino",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    date_diff('year', date(patient.birthdate), current_date) > 18 AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": "U0VMRUNUCiAgICBwYXRpZW50LmlkIEFTIHBhdGllbnRfaWQsCiAgICBkYXRlX2RpZmYoJ3llYXInLCBkYXRlKHBhdGllbnQuYmlydGhkYXRlKSwgY3VycmVudF9kYXRlKSA+IDE4IEFTIGlzX21ldApGUk9NIGZoaXIuZGVmYXVsdC5wYXRpZW50IEFTIHBhdGllbnQ="
          },
          {
            "contentType": "application/sql;dialect=duckdb",
            "extension": [
              {
                "url": "https://sql-on-fhir.org/ig/StructureDefinition/sql-text",
                "valueString": "SELECT\n    patient.id AS patient_id,\n    date_sub('year', CAST(patient.birthdate AS DATE), current_date) > 18 AS is_met\nFROM fhir.default.patient AS patient"
              }
            ],
            "data": "U0VMRUNUCiAgICBwYXRpZW50LmlkIEFTIHBhdGllbnRfaWQsCiAgICBkYXRlX3N1YigneWVhcicsIENBU1QocGF0aWVudC5iaXJ0aGRhdGUgQVMgREFURSksIGN1cnJlbnRfZGF0ZSkgPiAxOCBBUyBpc19tZXQKRlJPTSBmaGlyLmRlZmF1bHQucGF0aWVudCBBUyBwYXRpZW50"
          }
        ],
        "title": "Age over 18",
